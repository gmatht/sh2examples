+/// The clippy binary that shares this rustc's sysroot (`cargo clippy` needs
+/// a manifest; the net lints one file, so the driver is the right tool).
+fn clippy_driver() -> Option<std::path::PathBuf> {
+    let out = Command::new("rustc")
+        .args(["--print", "sysroot"])
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    let root = String::from_utf8_lossy(&out.stdout).trim().to_string();
+    let driver = Path::new(&root).join("bin").join("clippy-driver");
+    driver.exists().then_some(driver)
