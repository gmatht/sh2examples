#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- 'Warmup 1'
echo apple | perl -ne 'print "Fruit: $_\n"'
print -r -- '=== Example 1: Simple Perl one-liner ==='
perl -e 'print "Hello from Perl!\n"'
print -r -- '
=== Example 2: Perl with arguments ==='
perl -e 'foreach $arg (@ARGV) { print "Argument: $arg\n" }' first second third
print -r -- '
=== Example 3: Perl processing shell variables ==='
SHELL_VAR='Hello World'
perl -e 'print "Shell variable: $ENV{SHELL_VAR}\n"'
export SHELL_VAR
perl -e 'print "Shell variable: $ENV{SHELL_VAR}\n"'
print -r -- '
=== Example 4: Perl reading from pipeline ==='
print -- 'apple\nbanana\ncherry' | perl -ne 'chomp; print "Fruit: $_\n"'
print -r -- '
=== Example 5: Perl script with here document ==='
perl <<'EOF'
use strict;
use warnings;

my @numbers = (1, 2, 3, 4, 5);
my $sum = 0;

foreach my $num (@numbers) {
    $sum += $num;
    print "Added $num, sum is now $sum\n";
}

print "Final sum: $sum\n";
EOF
