#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
cd /tmp
printf '%s' 'default via 10.0.0.1 dev eth0 proto dhcp src 10.0.0.1 metric 100
' > grep_p_routes.txt
printf '%s' 'default via 10.7.7.7 dev vpn_se proto static
' > grep_p_routes2.txt
print -r -- '-- functions.sh / softy: lookbehind -o extraction --'
DEFAULT_ADAPTER="$(grep default grep_p_routes.txt | tail -1 | grep -Eo 'dev ([^[:space:]]+)' | sed 's/^dev //')"
print -r -- "adapter=[$DEFAULT_ADAPTER]"
print -r -- '-- jobs.sh: lookbehind -o + grep -v + head -1 --'
ADAPTER="$(grep default grep_p_routes2.txt | grep -Eo 'dev ([^[:space:]]+)' | sed 's/^dev //' | grep -v vpn_se | head -1)"
print -r -- "adapter2=[${ADAPTER:-EMPTY}]"
ADAPTER3="$(grep default grep_p_routes.txt grep_p_routes2.txt | grep -Eo 'dev ([^[:space:]]+)' | sed 's/^dev //' | grep -v vpn_se | head -1)"
print -r -- "adapter3=[${ADAPTER3:-EMPTY}]"
print -r -- '-- snap-debug-info.sh: non-capturing group + \s, -o --'
printf '%s' 'ID Status When
1 Doing now
2 Error now
3 Doing now
4 Error later
' > grep_p_snap.txt
DOINGS="$(cat grep_p_snap.txt | tail -n +2 | grep -Eo '([0-9]+[[:space:]]+Doing)' | awk '{print $1}')"
print -r -- "doings=[$DOINGS]"
ERRORS="$(cat grep_p_snap.txt | tail -n +2 | grep -Eo '([0-9]+[[:space:]]+Error)' | awk '{print $1}')"
print -r -- "errors=[$ERRORS]"
print -r -- '-- softy: FQDN validation pattern (kept as grep -P) --'
N="$(echo sub.example.com | grep -E -c '(?=^.{1,254}$)(^(?>(?!\d+\.)[a-zA-Z0-9_\-]{1,63}\.?)+(?:[a-zA-Z]{2,})$)')"
print -r -- "fqdn-count=$N"
N="$(echo 192.168.1.1 | grep -E -c '(?=^.{1,254}$)(^(?>(?!\d+\.)[a-zA-Z0-9_\-]{1,63}\.?)+(?:[a-zA-Z]{2,})$)')"
print -r -- "ip-count=$N"
print -r -- '-- memtester.sh / terminateProcess.sh: pgrep -P (untouched) --'
sleep 0.01 &
BGPID="$!"
CPID="$(pgrep -P "$BGPID" no-such-name-xyz 2>/dev/null || true)"
print -r -- "pgrep-no-match=[${CPID:-EMPTY}]"
wait "$BGPID" 2>/dev/null
exit 0
