cat >config.txt <<'EOF'
User: $USER
Host: ${HOSTNAME:-localhost}
Path: $PWD
EOF
{
    __ps_tmp4="$(mktemp)"
    cut -d : -f 1 /etc/passwd | sort >$__ps_tmp4
    __ps_tmp5="$(mktemp)"
    cut -d : -f 3 /etc/passwd | sort -n >$__ps_tmp5
    paste $__ps_tmp4 $__ps_tmp5 | head -10
    rm -f $__ps_tmp4 $__ps_tmp5
}
if printf '%s\n' ""$1"" | grep -Eq '^[0-9]+$' && case ""$2"" in "[tT][eE][sS][tT]") : ;; *) false ;; esac || case ""$2"" in "[dD][eE][bB][uU][gG]") : ;; *) false ;; esac; then
    print -r -- 'Valid input'
fi
