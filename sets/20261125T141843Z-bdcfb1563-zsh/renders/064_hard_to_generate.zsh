basename="${filename%.*}"
extension="${filename##*.}"
uppercase=MY_FILE.TXT
result="$(echo $(( $(wc -l < /etc/passwd) + $(wc -l < /etc/group) )))"
grep -v ^# /etc/passwd | cut -d : -f 1,3 | sort -t : -k 2 -n | head -5 >users.txt 2>errors.log
while IFS=: read -r user pass uid gid info home shell; do if [ $(( uid )) -gt $(( 1000 )) ] && case ""$shell"" in "/bin/false") false ;; *) : ;; esac; then if printf '%s\n' ""$home"" | grep -Eq '^/home/'; then printf '%s\n' "User: $user (UID: $uid) - $home"; fi; fi; done </etc/passwd
