#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS

: ${HOSTNAME:=${HOST:-localhost}}
{
    __ps_tmp1="$(mktemp)"
    { __ps_tmp0="$(mktemp)"; grep -v ^# /etc/passwd | cut -d : -f 1 >$__ps_tmp0; sort $__ps_tmp0; rm -f $__ps_tmp0; } >$__ps_tmp1
    __ps_tmp3="$(mktemp)"
    { __ps_tmp2="$(mktemp)"; grep -v ^# /etc/group | cut -d : -f 1 >$__ps_tmp2; sort $__ps_tmp2; rm -f $__ps_tmp2; } >$__ps_tmp3
    diff $__ps_tmp1 $__ps_tmp3
    rm -f $__ps_tmp1 $__ps_tmp3
}
