#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- '=== Number Factorization Examples ==='
factorize() {
    local n="$1"
    local divisor=2
    local factors
    print -rn -- "Factors of $n: "
    while [ $(( n )) -gt $(( 1 )) ]; do
        while [ $(( (n % divisor) )) -eq $(( 0 )) ]; do
            if ! [ "$factors" != "" ]; then
                factors="$divisor"
            else
                factors="$factors"" * $divisor"
            fi
            n=$(((n / divisor)))
        done
        divisor=$(((divisor + 1)))
        if [ $(( (divisor * divisor) )) -gt $(( n )) ]; then
            if [ $(( n )) -gt $(( 1 )) ]; then
                if ! [ "$factors" != "" ]; then
                    factors="$n"
                else
                    factors="$factors"" * $n"
                fi
            fi
            break
        fi
    done
    print -r -- "$factors"
}
factorize 12
factorize 28
factorize 100
factorize 12345
print -r -- 'Factorization complete!'
