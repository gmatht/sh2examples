#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS

    _readlink() {
        _rl_mode=f
        _rl_nl=0
        while [ "$#" -gt 1 ]; do
            case "$1" in
                -e) _rl_mode=e ;;
                -m) _rl_mode=m ;;
                -f) _rl_mode=f ;;
                -n) _rl_nl=1 ;;
                *) break ;;
            esac
            shift
        done
        for _rl_path in "$@"; do
            case $_rl_path in
                /*) ;;
                *) _rl_path=$PWD/$_rl_path ;;
            esac
            if [ "$_rl_mode" = m ]; then
                _rl_ifs=$IFS
                IFS=/
                # Leading empty field (the `/` that opens an absolute path)
                # and `.` components carry no meaning; `..` pops one
                # component, popping at the root is a no-op like GNU.
                _rl_out=
                for _rl_c in $_rl_path; do
                    case $_rl_c in
                        ''|.) ;;
                        ..)
                            case $_rl_out in
                                */*) _rl_out=${_rl_out%/*} ;;
                                '') ;;
                                *) _rl_out= ;;
                            esac ;;
                        *) _rl_out=${_rl_out:+$_rl_out/}$_rl_c ;;
                    esac
                done
                IFS=$_rl_ifs
                _rl_out=${_rl_out:-/}
                if [ "$_rl_nl" -eq 0 ]; then printf '%s\n' "$_rl_out"; else printf '%s' "$_rl_out"; fi
                continue
            fi
            _rl_dir=${_rl_path%/*}
            _rl_base=${_rl_path##*/}
            _rl_old=$PWD
            if cd "$_rl_dir" 2>/dev/null; then
                _rl_dir=$(pwd -P)
                cd "$_rl_old" || :
            elif [ "$_rl_mode" = e ]; then
                return 1
            fi
            _rl_n=0
            while [ -L "$_rl_dir/$_rl_base" ] && [ "$_rl_n" -lt 40 ]; do
                _rl_tgt=$(ls -ld "$_rl_dir/$_rl_base")
                _rl_tgt=${_rl_tgt#*" -> "}
                case $_rl_tgt in
                    /*) _rl_new=$_rl_tgt ;;
                    *) _rl_new=$_rl_dir/$_rl_tgt ;;
                esac
                _rl_dir=${_rl_new%/*}
                _rl_base=${_rl_new##*/}
                _rl_n=$((_rl_n + 1))
            done
            _rl_out=$_rl_dir/$_rl_base
            if [ "$_rl_mode" = e ] && [ ! -e "$_rl_out" ]; then
                return 1
            fi
            if [ "$_rl_nl" -eq 0 ]; then printf '%s\n' "$_rl_out"; else printf '%s' "$_rl_out"; fi
        done
    }

existing="$(_readlink -e /usr/bin/vi)"
missing="$(_readlink -m /nonexistent/path)"
full="$(_readlink -f /usr/bin/python3)"
print -r -- "Existing: $existing"
print -r -- "Missing:  $missing"
print -r -- "Full:     $full"
