#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
input_file="$(mktemp)"
max_lines=3
counter=0
printf '%s' '# comment
has $(sub) here
plain line
${param} line
' >"$input_file"
{
    __ps_tmp0="$(mktemp)"
    grep -v ^# "$input_file" | head -n 3 >$__ps_tmp0
    while { IFS='' true; read -r line && [ -n "$line" ] && [ "$((counter < max_lines))" -ne 0 ]; }; do if printf '%s\n' ""$line"" | grep -Eq '^[[:space:]]*#'; then continue; fi; case "$line" in *\$\(*\)*) print -r -- "Contains command substitution: $line";; *\$\{[^}]*\}*) print -r -- "Contains parameter expansion: $line";; *\$\(\(*\)\)*) print -r -- "Contains arithmetic expansion: $line";; esac; { ((((counter = counter + 1) - 1))); }; done <$__ps_tmp0
    rm -f $__ps_tmp0
}
rm -f "$input_file"
