#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- '=== File and Directory Operations ==='
d="$(mktemp -d)"
cd "$d" || exit 1
printf '%s' 'a
' > a.sh
printf '%s' 'b
' > b.txt
mkdir sub
printf '%s' 'c
' > sub/c.sh
printf '%s' 'x
' > .hidden
file_list="$(ls -A | sort)"
print -r -- 'File listing:'
print -r -- "$file_list"
found_files="$(find . -name '*.sh' -type f)"
print -r -- 'Found shell scripts:'
print -r -- "$found_files"
cd /
rm -r -f "$d"
print -r -- '=== File and Directory Operations Complete ==='
