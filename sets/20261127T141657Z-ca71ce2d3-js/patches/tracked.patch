+
+/// Function definitions anywhere in the tree (a definition nested in a
+/// block or an `if` arm still defines the name for later calls).
+fn collect_fn_bodies<'a>(stmts: &'a [IrStmt], out: &mut Vec<(String, &'a [IrStmt])>) {
+    for s in stmts {
+        match s {
+            IrStmt::Function { name, body, .. } => {
+                out.push((name.clone(), body));
+                collect_fn_bodies(body, out);
+            }
+            IrStmt::If {
+                then,
+                elsifs,
+                else_,
+                ..
+            } => {
+                collect_fn_bodies(then, out);
+                for (_, b) in elsifs {
+                    collect_fn_bodies(b, out);
+                }
+                collect_fn_bodies(else_, out);
+            }
+            IrStmt::For { body, .. }
+            | IrStmt::While { body, .. }
+            | IrStmt::DoWhile { body, .. }
+            | IrStmt::Block(body)
+            | IrStmt::Shaderize { body, .. } => collect_fn_bodies(body, out),
+            IrStmt::ForInit {
+                init, step, body, ..
+            } => {
+                collect_fn_bodies(init, out);
+                collect_fn_bodies(step, out);
+                collect_fn_bodies(body, out);
+            }
+            IrStmt::Case { clauses, .. } => {
+                for c in clauses {
+                    collect_fn_bodies(&c.body, out);
+                }
+            }
+            IrStmt::Try {
+                body,
+                excepts,
+                else_body,
+                finally_body,
+            } => {
+                collect_fn_bodies(body, out);
+                for e in excepts {
+                    collect_fn_bodies(&e.body, out);
+                }
+                collect_fn_bodies(else_body, out);
+                collect_fn_bodies(finally_body, out);
+            }
+            _ => {}
+        }
+    }
+}
