+/// Post-lift recognizer — the OTHER half of this transform's contract, for
+/// backends that keep a stdout sink: the shape pass 2 leaves behind, which
+/// returns the bytes pass 1 recognized as the function's output and prints
+/// nothing. A `fnValue` call site uses it to tell the callee's RETURNED
+/// value (this shape: the value IS what bash printed there) from bytes the
+/// callee printed itself (any other shape: the sink is still needed).
+///
+/// `eligible` names callees that are themselves value-returning, so a
+/// capture of one is a pure value read (wcLines' `r=$(strCount …)`, which
+/// pass 3 collapses to the bare `fnValue`).
+///
+/// REFUSE > GUESS: anything the pass-1 purity check would have refused —
+/// stdout, a child command, a capture it could not prove pure, a `$?` read
+/// — is refused here, and the caller keeps the stdout-sink path.
+pub fn is_value_returning(body: &[IrStmt], eligible: &HashSet<String>) -> bool {
+    let none = HashSet::new();
+    let mut ends = false;
+    let silent = body
+        .iter()
+        .all(|s| post_lift_silent(s, eligible, &none, &mut ends));
+    // `ends` says a value return exists; `all_paths_return` says EVERY path
+    // reaches one (a fall-through would be a python `None` at the call site,
+    // and bash printed nothing there — the lift's own state machine never
+    // produces such a body, so this only guards the recognizer's own claim).
+    silent && ends && all_paths_return(body)
+}
+
+/// Does every path through this list end in `return <value>`?
+fn all_paths_return(stmts: &[IrStmt]) -> bool {
+    for (i, s) in stmts.iter().enumerate() {
+        match s {
+            IrStmt::Return(Some(e)) => return !matches!(e, IrExpr::Int(_)),
+            IrStmt::Return(None) => return false,
+            // only the LAST statement can close the list's paths
+            IrStmt::If {
+                then,
+                elsifs,
+                else_,
+                ..
+            } if i + 1 == stmts.len() => {
+                return !then.is_empty()
+                    && all_paths_return(then)
+                    && elsifs
+                        .iter()
+                        .all(|(_, b)| !b.is_empty() && all_paths_return(b))
+                    && !else_.is_empty()
+                    && all_paths_return(else_);
+            }
+            // a `case` closes the paths when every clause returns and a
+            // `*` default clause catches the rest (061's test_math family)
+            IrStmt::Case { clauses, .. } if i + 1 == stmts.len() => {
+                return clauses
+                    .iter()
+                    .any(|c| c.patterns.iter().any(|p| p == "*"))
+                    && clauses
+                        .iter()
+                        .all(|c| !c.body.is_empty() && all_paths_return(&c.body));
+            }
+            IrStmt::Block(b) if i + 1 == stmts.len() => return all_paths_return(b),
+            _ => {}
+        }
+    }
+    false
+}
+
+/// `stmt_silent` with the pass-2 rewrite's arm added: a `return <value>` is
+/// the lowered echo (silent — the value is the caller's business), while a
+/// `return 3` is a STATUS and a bare `return` has nothing to return.
+fn post_lift_silent(
+    st: &IrStmt,
+    eligible: &HashSet<String>,
+    scc: &HashSet<String>,
+    ends: &mut bool,
+) -> bool {
+    match st {
+        IrStmt::Return(Some(IrExpr::Int(_))) | IrStmt::Return(None) => false,
+        IrStmt::Return(Some(e)) => {
+            *ends = true;
+            expr_pure(e, eligible, scc)
+        }
+        IrStmt::If {
+            cond,
+            then,
+            elsifs,
+            else_,
+        } => {
+            expr_pure(cond, eligible, scc)
+                && then.iter().all(|s| post_lift_silent(s, eligible, scc, ends))
+                && elsifs.iter().all(|(c, b)| {
+                    expr_pure(c, eligible, scc)
+                        && b.iter().all(|s| post_lift_silent(s, eligible, scc, ends))
+                })
+                && else_.iter().all(|s| post_lift_silent(s, eligible, scc, ends))
+        }
+        IrStmt::While { cond, body } => {
+            (is_read_loop(cond) || expr_pure(cond, eligible, scc))
+                && body.iter().all(|s| post_lift_silent(s, eligible, scc, ends))
+        }
+        IrStmt::For { iter, body, .. } => {
+            expr_pure(iter, eligible, scc)
+                && body.iter().all(|s| post_lift_silent(s, eligible, scc, ends))
+        }
+        IrStmt::DoWhile { body, cond, .. } => {
+            expr_pure(cond, eligible, scc)
+                && body.iter().all(|s| post_lift_silent(s, eligible, scc, ends))
+        }
+        IrStmt::Block(body) => body.iter().all(|s| post_lift_silent(s, eligible, scc, ends)),
+        IrStmt::Case {
+            discriminant,
+            clauses,
+        } => {
+            expr_pure(discriminant, eligible, scc)
+                && clauses
+                    .iter()
+                    .all(|c| c.body.iter().all(|s| post_lift_silent(s, eligible, scc, ends)))
+        }
+        IrStmt::Redirect { inner, redirects } => {
+            redirects.iter().all(|r| {
+                matches!(r.mode.as_str(), "herestring" | "heredoc")
+                    && expr_pure(&r.target, eligible, scc)
+            }) && inner.iter().all(|s| post_lift_silent(s, eligible, scc, ends))
+        }
+        other => stmt_silent(other, eligible, scc),
+    }
+}
