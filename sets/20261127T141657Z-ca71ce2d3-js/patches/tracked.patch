+/// The recognizer lives in the transform that owns the convention
+/// (`echo_return::is_value_returning`), so the call-site decision and the
+/// body rewrite cannot drift apart. The fixpoint is the same one pass 1
+/// runs: a body that CAPTURES another value-returning function is itself
+/// value-returning once that callee is (wcLines' `r=$(strCount …)`).
+fn value_returning_fns(stmts: &[IrStmt]) -> HashSet<String> {
+    let mut fns: Vec<(String, &[IrStmt])> = Vec::new();
+    collect_fn_bodies(stmts, &mut fns);
+    let mut eligible: HashSet<String> = HashSet::new();
+    loop {
+        let mut grew = false;
+        for (name, body) in &fns {
+            if !eligible.contains(name)
+                && crate::transforms::echo_return::is_value_returning(body, &eligible)
+            {
+                eligible.insert(name.clone());
+                grew = true;
+            }
+        }
+        if !grew {
+            break;
+        }
+    }
+    eligible
