#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

printf '%s\n' '=== Basic Command Substitution ==='
printf '%s\n' (string join '' -- "Current date: " (begin
date +%Y
end))
printf '%s\n' (string join '' -- "Current directory: " (begin
basename $(pwd)
end))
set current_date (begin
date +%Y%m
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
set current_dir (begin
basename $(pwd)
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Stored date: $current_date"
printf '%s\n' "Stored directory: $current_dir"
printf '%s\n' '=== Basic Command Substitution Complete ==='
