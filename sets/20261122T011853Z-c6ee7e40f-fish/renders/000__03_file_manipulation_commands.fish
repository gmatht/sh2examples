#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

printf '%s\n' '=== File Manipulation Commands ==='
printf '%s\n' '=== cp command ==='
set d (begin
mktemp -d
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
cd "$d" || exit 1
printf '%s\n' ''
printf '%s' 'test content
' > test_file.txt
set cp_result (begin
begin 
cp test_file.txt test_file_copy.txt && echo 'Copy successful'
end
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Copy result: $cp_result"
ls test_file.txt test_file_copy.txt test_file_moved.txt 2>/dev/null | sort; test $pipestatus[1] -eq 0 || echo 'No test files found'
printf '%s\n' ''
printf '%s\n' '=== mv command ==='
set mv_result (begin
begin 
mv test_file_copy.txt test_file_moved.txt && echo 'Move successful'
end
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Move result: $mv_result"
ls test_file.txt test_file_copy.txt test_file_moved.txt 2>/dev/null | sort; test $pipestatus[1] -eq 0 || echo 'No test files found'
printf '%s\n' ''
printf '%s\n' '=== rm command ==='
set rm_result (begin
begin 
rm test_file.txt test_file_moved.txt && echo 'Remove successful'
end
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Remove result: $rm_result"
ls test_file.txt test_file_copy.txt test_file_moved.txt 2>/dev/null | sort; test $pipestatus[1] -eq 0 || echo 'No test files found'
printf '%s\n' ''
printf '%s\n' '=== mkdir command ==='
set mkdir_result (begin
begin 
mkdir test_dir && echo 'Directory created'
end
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Mkdir result: $mkdir_result"
touch test_dir/file
ls test_dir 2>/dev/null | sort; test $pipestatus[1] -eq 0 || echo 'Directory not found'
rm test_dir/file
rmdir test_dir
printf '%s\n' ''
printf '%s\n' '=== touch command ==='
set touch_result (begin
begin 
touch test_file.txt && echo 'File touched'
end
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Touch result: $touch_result"
printf '%s\n' ''
rm -f test_file.txt test_file_copy.txt test_file_moved.txt
rm -r -f test_dir 2>/dev/null || true
cd /
rm -r -f "$d"
