#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

printf '%s\n' '=== Output and Formatting Commands ==='
printf '%s\n' "Echo result: Hello from backticks"
printf '%s\n' "Printf result: Number: 42, String: test"
printf '%s\n' '=== Compression Commands ==='
printf '%s\n' '=== Network Commands ==='
printf '%s\n' '=== Process Management Commands ==='
set d (begin
mktemp -d
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
cd "$d" || exit 1
printf '%s\n' '=== Checksum Commands ==='
printf '%s' 'test content
' > test_checksum.txt
set sha256_result (begin
sha256sum test_checksum.txt
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "SHA256 result: $sha256_result"
set sha512_result (begin
sha512sum test_checksum.txt
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "SHA512 result: $sha512_result"
set strings_result (begin
strings test_binary.txt | head -3
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'Strings result:'
printf '%s\n' "$strings_result"
printf '%s\n' '=== I/O Redirection Commands ==='
set tee_result (begin
echo 'test output' | tee test_tee.txt
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Tee result: $tee_result"
printf '%s\n' '=== Perl Command ==='
set perl_result (begin
perl -e 'print "Hello from Perl\\n"'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Perl result: $perl_result"
rm -f test_checksum.txt test_tee.txt
cd /
rm -r -f "$d"
