#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
set filename my_file.txt
set basename (string match -rg -- '^(.*)\..*$' "$filename"; or printf '%s' "$filename")
set extension (string match -rg -- '^.*\.(.*)$' "$filename"; or printf '%s' "$filename")
printf '%s\n' "Basename: $basename"
printf '%s\n' "Extension: $extension"
printf '%s\n' "Uppercase: MY_FILE.TXT"
printf '%s\n' "Lowercase: my_file.txt"
