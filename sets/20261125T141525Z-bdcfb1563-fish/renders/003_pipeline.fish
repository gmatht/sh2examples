#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

set d (begin
mktemp -d
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
cd "$d" || exit 1
printf '%s' 'apple
apple
' > file.txt
printf '%s' 'hello.txt
' > note.txt
printf '%s' 'function f() { echo hi; }
' > s.sh
ls | sort | grep '\\.txt$' | wc -l
printf '%s\n' ''
cat file.txt | sort | uniq -c | sort -n -r
printf '%s\n' ''
find . -name '*.sh' | xargs grep -l function | tr -d '\\\\/'
printf '%s\n' ''
cat file.txt | tr a b | grep hello
printf '%s\n' ''
cat file.txt | sort | grep hello
cd /
rm -r -f "$d"
