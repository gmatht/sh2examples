#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function _num --argument val
    # bash coerces non-numeric arith values to 0; fish math errors
    if string match -qr -- '^-?[0-9]+$' $val
        echo $val
    else
        echo 0
    end
end

:
set matrix_0_0 (math --scale 0 "(($(_num $x) + $(_num $y)) * $(_num $z))"); set matrix_len (math --scale 0 "$matrix_len + 1"); set -a matrix_keys 0_0
set matrix_1_1 (set -l _i (math --scale 0 "$index + 1"); printf '%s\n' $array[$_i]); set matrix_len (math --scale 0 "$matrix_len + 1"); set -a matrix_keys 1_1
set matrix_2_2 (seq 0 (math (count $prefix) - 1)); set matrix_len (math --scale 0 "$matrix_len + 1"); set -a matrix_keys 2_2
set matrix_3_3 (count $array); set matrix_len (math --scale 0 "$matrix_len + 1"); set -a matrix_keys 3_3
printf '%s\n' 'Matrix assignments completed'
