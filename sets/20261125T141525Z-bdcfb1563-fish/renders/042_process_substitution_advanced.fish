#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
set u
printf '%s\n' '== More process substitution examples =='
set __ps_tmp0 "$(mktemp)"
printf '%b\n' 'a\\nc\\nb' | sort >$__ps_tmp0
set __ps_tmp1 "$(mktemp)"
printf '%b\n' 'a\\nb\\nd' | sort >$__ps_tmp1
diff $__ps_tmp0 $__ps_tmp1 && rm -f $__ps_tmp0 $__ps_tmp1 || echo 'Files differ'
begin
    set __ps_tmp2 "$(mktemp)"
    printf '%s' 'name1
name2
' > $__ps_tmp2
    set __ps_tmp3 "$(mktemp)"
    printf '%s' 'value1
value2
' > $__ps_tmp3
    paste $__ps_tmp2 $__ps_tmp3
    set -l _ps_rc $status
    rm -f $__ps_tmp2 $__ps_tmp3
    test $_ps_rc -eq 0
end
printf '%s\n' "status: ok"
