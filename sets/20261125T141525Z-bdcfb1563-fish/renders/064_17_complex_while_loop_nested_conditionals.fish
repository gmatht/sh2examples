#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
while begin; read -l __sh2_ifs_line; set __sh2_ifs_parts (string split ":" -- $__sh2_ifs_line); set user $__sh2_ifs_parts[1]; set pass $__sh2_ifs_parts[2]; set uid $__sh2_ifs_parts[3]; set gid $__sh2_ifs_parts[4]; set info $__sh2_ifs_parts[5]; set home $__sh2_ifs_parts[6]; set shell $__sh2_ifs_parts[7]; test (count $__sh2_ifs_parts) -gt 0; end; if [ "$uid" -gt 1000 ] && [ "$shell" != "/bin/false" ]; if printf '%s\n' ""$home"" | grep -Eq '^/home/'; printf '%s\n' "User: $user (UID: $uid) - $home"
end
end
end </etc/passwd
