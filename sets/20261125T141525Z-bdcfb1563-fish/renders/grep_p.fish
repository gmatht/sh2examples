#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#

# portable PCRE grep: GNU grep -P, macOS gnu-grep, pcregrep/pcre2grep, or perl
function grep_p
    set -l _gp_flags
    while count $argv >/dev/null; and test (count $argv) -gt 0
        if test $argv[1] = --
            set -e argv[1]
            break
        else if string match -qr '^-' -- $argv[1]
            set -a _gp_flags $argv[1]
            set -e argv[1]
        else
            break
        end
    end
    if test (count $argv) -eq 0
        return 1
    end
    set -l _gp_pat $argv[1]
    set -e argv[1]
    if grep -P $_gp_flags -- $_gp_pat $argv 2>/dev/null
        return 0
    end
    if command -v ggrep >/dev/null 2>&1
        ggrep -P $_gp_flags -- $_gp_pat $argv
        return $status
    end
    if command -v pcre2grep >/dev/null 2>&1
        pcre2grep $_gp_flags -- $_gp_pat $argv
        return $status
    end
    if command -v pcregrep >/dev/null 2>&1
        pcregrep $_gp_flags -- $_gp_pat $argv
        return $status
    end
    set -l _gp_perl 'BEGIN{$p=shift @ARGV} print if /$p/'
    if string match -q -- '*-o*' -- (string join ' ' -- $_gp_flags)
        set _gp_perl 'BEGIN{$p=shift @ARGV} while (/$p/g) { print "$&\n" }'
    end
    perl -ne $_gp_perl -- $_gp_pat $argv
    return $status
end

function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

cd /tmp
printf '%s' 'default via 10.0.0.1 dev eth0 proto dhcp src 10.0.0.1 metric 100
' > grep_p_routes.txt
printf '%s' 'default via 10.7.7.7 dev vpn_se proto static
' > grep_p_routes2.txt
printf '%s\n' '-- functions.sh / softy: lookbehind -o extraction --'
set DEFAULT_ADAPTER (begin
grep default grep_p_routes.txt | tail -1 | grep -Eo 'dev ([^[:space:]]+)' | sed 's/^dev //'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "adapter=[$DEFAULT_ADAPTER]"
printf '%s\n' '-- jobs.sh: lookbehind -o + grep -v + head -1 --'
set ADAPTER (begin
grep default grep_p_routes2.txt | grep -Eo 'dev ([^[:space:]]+)' | sed 's/^dev //' | grep -v vpn_se | head -1
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' (string join '' -- "adapter2=[" (test -n "$ADAPTER"; and printf '%s' "$ADAPTER"; or printf '%s' "EMPTY") "]")
set ADAPTER3 (begin
grep default grep_p_routes.txt grep_p_routes2.txt | grep -Eo 'dev ([^[:space:]]+)' | sed 's/^dev //' | grep -v vpn_se | head -1
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' (string join '' -- "adapter3=[" (test -n "$ADAPTER3"; and printf '%s' "$ADAPTER3"; or printf '%s' "EMPTY") "]")
printf '%s\n' '-- snap-debug-info.sh: non-capturing group + \\s, -o --'
printf '%s' 'ID Status When
1 Doing now
2 Error now
3 Doing now
4 Error later
' > grep_p_snap.txt
set DOINGS (begin
cat grep_p_snap.txt | tail -n +2 | grep -Eo '([0-9]+[[:space:]]+Doing)' | awk '{print $1}'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "doings=[$DOINGS]"
set ERRORS (begin
cat grep_p_snap.txt | tail -n +2 | grep -Eo '([0-9]+[[:space:]]+Error)' | awk '{print $1}'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "errors=[$ERRORS]"
printf '%s\n' '-- softy: FQDN validation pattern (kept as grep -P) --'
set N (begin
echo sub.example.com | grep_p -c '(?=^.{1,254}$)(^(?>(?!\\d+\\.)[a-zA-Z0-9_\\-]{1,63}\\.?)+(?:[a-zA-Z]{2,})$)'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "fqdn-count=$N"
set N (begin
echo 192.168.1.1 | grep_p -c '(?=^.{1,254}$)(^(?>(?!\\d+\\.)[a-zA-Z0-9_\\-]{1,63}\\.?)+(?:[a-zA-Z]{2,})$)'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "ip-count=$N"
printf '%s\n' '-- memtester.sh / terminateProcess.sh: pgrep -P (untouched) --'
sleep 0.01 &
set BGPID """"
set CPID (begin
begin 
pgrep -P "$BGPID" no-such-name-xyz 2>/dev/null || true
end
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' (string join '' -- "pgrep-no-match=[" (test -n "$CPID"; and printf '%s' "$CPID"; or printf '%s' "EMPTY") "]")
wait "$BGPID" 2>/dev/null
exit 0
