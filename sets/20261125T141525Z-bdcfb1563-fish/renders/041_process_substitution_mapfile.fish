#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
set u
printf '%s\n' '== readarray/mapfile =='
begin
    set __ps_tmp0 "$(mktemp)"
    printf '%s' 'x
y
' > $__ps_tmp0
    set -e lines
while read -l _mf_line
    set -a lines $_mf_line
end <$__ps_tmp0
    set -l _ps_rc $status
    rm -f $__ps_tmp0
    test $_ps_rc -eq 0
end
printf '%s ' (string join ' ' $lines)
printf '%s\n' ''
