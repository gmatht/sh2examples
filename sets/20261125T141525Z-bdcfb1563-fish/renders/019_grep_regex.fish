#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

echo 'foo123 bar456' | grep -E '(foo|bar)[0-9]+'
echo 'a+b*c?' | grep -F 'a+b*c?'
echo 'word wordly subword' | grep -w word
printf '%b\n' 'exact whole line\\npartial line' | grep -x 'exact whole line'
printf '%b\n' 'error message\\nwarning message\\ninfo message' | grep -E 'error|warning'
begin
    set __ps_tmp0 "$(mktemp)"
    printf '%s' 'error
warning
' > $__ps_tmp0
    printf '%b\n' 'error\\nwarning' | grep -f $__ps_tmp0
    set -l _ps_rc $status
    rm -f $__ps_tmp0
    test $_ps_rc -eq 0
end
echo 'file123.txt backup456.bak' | grep -E '([a-z]+)([0-9]+)\\.([a-z]+)'
set matched (begin
printf '%s\n' test | grep -c '.*'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "  grep_exit: $status"
printf '%s\n' "  match_count: $matched"
