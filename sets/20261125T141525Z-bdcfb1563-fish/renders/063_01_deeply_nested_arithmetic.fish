#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
begin
    set a 10
    set b 3
    set c 8
    set d 2
    set e 7
    set f 2
    set g 2
    set h 3
    set i 4
    set j 1
    set k 6
    set l 3
    set m 5
    set n 2
end
set result (math --scale 0 "bitor(((((($a + $b) * ($c - $d)) / ($e % $f)) + ($g ^ $h)) - ($i * (2 ^ $j))), bitxor(bitand($k, $l), bitor($m, $n)))")
printf '%s\n' "Deeply nested arithmetic result: $result"
