+/// The capture collapse (2026-10-16, round 2): a four-line `$( … )` block
+/// whose body is one exec statement becomes the tuple-wrapped native
+/// capture. Pinned shapes: the sink-fish arms (plain and fed), the
+/// `__sh_run`/`__sh_spawn` arms incl. their `bash -c` fallback, and every
+/// REFUSE — an enclosing sink region, an fd-0 override, a feed the fallback
+/// cannot spell, a `via_ret`/multi-line body.
+#[cfg(test)]
+mod capture_collapse_tests {
+    /// The four rendered lines of a single-statement capture block.
+    fn block(body: &str) -> String {
+        format!(
+            "    let __cap_state = __sh_cap_begin();\n    {body}\n    let __s = __sh_cap_end(__cap_state, false);\n    __s\n"
+        )
+    }
+
+    /// A sink-fish body exactly as `native_sink_cmd_call` renders it inside
+    /// a capture: piped stdout, read to EOF, deposited into the sink — which
+    /// there is the capture buffer itself.
+    fn fish(chain: &str, stdin: &str) -> String {
+        format!(
+            "__SH_RC.store({{ let _ = std::io::Write::flush(&mut std::io::stdout()); match {chain}{stdin}.stdout(std::process::Stdio::piped()).spawn() {{ Ok(mut __cc) => {{ let mut __co: Vec<u8> = Vec::new(); if let Some(mut __cs) = __cc.stdout.take() {{ let _ = std::io::Read::read_to_end(&mut __cs, &mut __co); }} let __cr = __cc.wait().map(|s| s.code().unwrap_or(1)).unwrap_or(1); {dep} __cr }}, Err(e) => {nocmd} }} }}, Ordering::SeqCst);",
+            chain = chain,
+            stdin = stdin,
+            dep = super::SINK_DEPOSIT,
+            nocmd = super::BASH_NOCMD,
+        )
+    }
+
+    #[test]
+    fn plain_sink_fish_collapses_to_native_capture() {
+        let src = block(&fish("std::process::Command::new(\"mktemp\")", ""));
+        let out = super::collapse_single_stmt_captures(&src);
+        assert!(!out.contains("__sh_cap_begin"), "{out}");
+        assert!(!out.contains("__sh_cap_end"), "{out}");
+        assert!(
+            out.contains("std::process::Command::new(\"mktemp\").stdin(std::process::Stdio::inherit()).output()"),
+            "{out}"
+        );
+        // the status write and the block's value both survive
+        assert!(out.contains("__SH_RC.store(__r, Ordering::SeqCst);"), "{out}");
+        assert!(out.contains("let (__c, __r) = "), "{out}");
+        assert!(out.lines().last().map(|l| l.trim()) == Some("__c"), "{out}");
+    }
+
+    #[test]
+    fn fed_sink_fish_keeps_its_feed() {
+        let src = block(&fish(
+            "std::process::Command::new(\"grep\")",
+            ".stdin(std::process::Stdio::piped())",
+        ));
+        // the write-all the fish used to feed fd 0 — the fish text needs it
+        // before the stdout marker for the classifier's stdin/chain split
+        let src = src.replace(
+            ".stdout(std::process::Stdio::piped()).spawn()",
+            ".stdout(std::process::Stdio::piped()).spawn()",
+        );
+        let with_feed = src.replace(
+            "Ok(mut __cc) => {",
+            "Ok(mut __cc) => { if let Some(mut __ci) = __cc.stdin.take() { let _ = std::io::Write::write_all(&mut __ci, &feed_buf); }",
+        );
+        let out = super::collapse_single_stmt_captures(&with_feed);
+        assert!(!out.contains("__sh_cap_begin"), "{out}");
+        assert!(out.contains("wait_with_output()"), "{out}");
+        assert!(out.contains("write_all(&mut __ci, &feed_buf)"), "{out}");
+        assert!(out.contains(".stdin(std::process::Stdio::piped())"), "{out}");
+    }
+
+    #[test]
+    fn literal_spawn_lowers_and_a_refused_argv_falls_back_to_capture_rc() {
+        // a literal simple command → the native chain, zero seam
+        let src = block("__SH_RC.store(__sh_spawn(\"'uname'\", None), Ordering::SeqCst);");
+        let out = super::collapse_single_stmt_captures(&src);
+        assert!(!out.contains("__sh_cap_begin"), "{out}");
+        assert!(out.contains("Command::new(\"uname\")"), "{out}");
+
+        // a BUILTIN argv: cmd_argv refuses, the bash -c spelling keeps one
+        // seam instead of the pair — pwd stays pwd's builtin
+        let src = block("__SH_RC.store(__sh_run(\"'pwd'\"), Ordering::SeqCst);");
+        let out = super::collapse_single_stmt_captures(&src);
+        assert!(!out.contains("__sh_cap_begin"), "{out}");
+        assert!(out.contains("__sh_capture_rc(\"'pwd'\")"), "{out}");
+    }
+
+    #[test]
+    fn refusals_keep_the_pair() {
+        // an enclosing fd-1 sink region: the fish's deposit lands there, so
+        // the begin/end pair is load-bearing
+        let src = format!(
+            "{{\n    __SH_OUTFILE_TL.with(|v| *v.borrow_mut() = Some(f));\n{b}    __SH_OUTFILE_TL.with(|v| *v.borrow_mut() = old);\n}}\n",
+            b = block(&fish("std::process::Command::new(\"mktemp\")", ""))
+        );
+        let out = super::collapse_single_stmt_captures(&src);
+        assert!(out.contains("__sh_cap_begin"), "sink region not honoured: {out}");
+
+        // a spawn FEED whose argv cmd_argv refused: capture_rc has no
+        // spelling for the feed, so the pair stays
+        let src = block("__SH_RC.store(__sh_spawn(\"'pwd'\", Some(&buf)), Ordering::SeqCst);");
+        let out = super::collapse_single_stmt_captures(&src);
+        assert!(out.contains("__sh_cap_begin"), "refused feed was collapsed: {out}");
+
+        // a two-statement body (print + status) is a different shape
+        let src = format!(
+            "    let __cap_state = __sh_cap_begin();\n    __sh_puts(\"x\");\n    __SH_RC.store(0, Ordering::SeqCst);\n    let __s = __sh_cap_end(__cap_state, false);\n    __s\n"
+        );
+        let out = super::collapse_single_stmt_captures(&src);
+        assert!(out.contains("__sh_cap_begin"), "multi-line body collapsed: {out}");
+    }
+
+    // ── `${arr[@]}` whole-list reads (the "@" offset marker) ────────
+    // The list marker is not a number: the general slice path used to
+    // parse it at runtime (`"@".trim().parse::<i64>().unwrap_or(0)`) and
+    // then run the full negative-offset/length clamp dance — four `as`
+    // casts per site — just to clone an array.
+
+    fn render_full(src: &str) -> String {
+        let commands = crate::Parser::new(src).parse().expect("parse");
+        let prog = crate::shir::ast_to_ir(&commands);
+        super::shir_to_rust(&prog)
+    }
+
+    #[test]
+    fn whole_list_read_is_a_clean_array_clone() {
+        // a RUNTIME-built array (the const-array path would fold the
+        // literal to `arr.iter()` regardless)
+        let out = render_full(
+            "f() { local a=(\"$1\" \"$2\"); for x in \"${a[@]}\"; do echo \"$x\"; done; }\nf p q\n",
+        );
+        assert!(
+            out.contains(".with(|v| v.borrow().clone())") || out.contains(".to_vec()"),
+            "whole-list read is an array clone:\n{out}"
+        );
+        assert!(
+            !out.contains("\"@\".to_string().trim().parse"),
+            "the list marker must not be parsed as a number:\n{out}"
+        );
+        assert!(!out.contains("__sh_substr("), "{out}");
+    }
+
+    #[test]
+    fn whole_list_read_in_argv_is_the_same_clone() {
+        let out = render_full("arr=(x y)\nf \"${arr[@]}\"\n");
+        assert!(
+            !out.contains("\"@\".to_string().trim().parse"),
+            "argv list read skips the parse too:\n{out}"
+        );
+    }
+
+    #[test]
+    fn whole_list_read_argv_local_array_folds_too() {
+        // the corpus shape: `local cmd=("$@")` — setArray over listVar
+        let out = render_full(
+            "f() { local cmd=(\"$@\"); for x in \"${cmd[@]}\"; do echo \"$x\"; done; }\nf p q\n",
+        );
+        assert!(
+            !out.contains("\"@\".to_string().trim().parse"),
+            "argv-built local folds too:\n{out}"
+        );
+    }
+
+    #[test]
+    fn a_real_offset_keeps_the_general_slice() {
+        // `${arr[@]:1}` — offset 1 is a genuine sublist, not the whole
+        let src_for = |off: &str| {
+            format!(
+                "f() {{ local a=(\"$1\" \"$2\"); for x in \"${{a[@]{off}}}\"; do echo \"$x\"; done; }}\nf p q\n"
+            )
+        };
+        let whole = render_full(&src_for(""));
+        let sliced = render_full(&src_for(":1"));
+        assert_ne!(whole, sliced, "offset 1 must still slice");
+        // the whole-list form is the clone; the sliced form keeps bounds logic
+        assert!(!sliced.contains(".with(|a| a.borrow().clone())"), "{sliced}");
+    }
+
+    #[test]
+    fn an_undeclared_name_keeps_the_general_path() {
+        // refuse-on-doubt: only a DECLARED indexed array folds
+        let out = render_full("for x in \"${zzz[@]}\"; do echo \"$x\"; done\n");
+        assert!(
+            !out.contains("\"@\".to_string().trim().parse"),
+            "even the undeclared path must not parse the marker (marker offsets are non-numeric by grammar)",
+        );
+    }
+
+    #[test]
+    fn scalar_len_reads_are_untouched() {
+        // `${#arr[@]}` is a LENGTH — reaches the renderer as arrayLen
+        // (array-len-fold's job in the shared pipeline) or as the #
+        // slice spelling; either way it is not the list clone. A
+        // runtime-built array keeps the count dynamic (.len()); a
+        // literal array const-folds the count at render time.
+        let out = render_full("f() { local a=(\"$1\"); echo \"${#a[@]}\"; }\nf p\n");
+        assert!(out.contains(".len()"), "length uses .len():\n{out}");
+        assert!(!out.contains("\"@\".to_string().trim().parse"), "{out}");
+    }
+}
