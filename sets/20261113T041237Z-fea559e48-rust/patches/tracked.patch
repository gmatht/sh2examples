+    /// the capture pair inlines at every canonical site with per-site
+    /// gensym'd locals (nested pairs get distinct indices, LIFO pairing),
+    /// a `via_ret=true` end and an unbalanced pair refuse the file, an
+    /// unknown def body refuses everything, and the emitted strip loop
+    /// carries the same char literal as the helper.
+    #[test]
+    fn cap_pairs_inline_with_gensym_locals() {
+        let def = "fn __sh_cap_begin() -> __ShCapState {\n    let oldout = __SH_OUTFILE_TL.with(|v| v.borrow_mut().take());\n    let old = __SH_OUT.lock().unwrap().take();\n    *__SH_OUT.lock().unwrap() = Some(Vec::new());\n    let oldin = __SH_STDIN.lock().unwrap().take();\n    (old, oldin, oldout)\n}\nfn __sh_cap_end(st: __ShCapState, via_ret: bool) -> String {\n    let (old, oldin, oldout) = st;\n    *__SH_STDIN.lock().unwrap() = oldin;\n    let cap_out = __SH_OUT.lock().unwrap().take().unwrap();\n    *__SH_OUT.lock().unwrap() = old;\n    __SH_OUTFILE_TL.with(|v| *v.borrow_mut() = oldout);\n    let mut s = if !via_ret { String::from_utf8_lossy(&cap_out).to_string() } else {\n        let cap_ret = __SH_RET.lock().unwrap().clone();\n        *__SH_RET.lock().unwrap() = String::new();\n        if cap_out.is_empty() { cap_ret } else { String::from_utf8_lossy(&cap_out).to_string() }\n    };\n    // `$(...)` strips the trailing newlines\n    while s.ends_with('\\n') { s.pop(); }\n    s\n}\n";
+        let site = "let __cap_state = __sh_cap_begin();\nlet x = 1;\nlet __s = __sh_cap_end(__cap_state, false);\n";
+        let src = format!("{def}fn main() {{\n{site}}}\n");
+        let out = super::inline_cap_pairs(&src);
+        assert!(out.contains("let __cap0_outf = __SH_OUTFILE_TL.with(|v| v.borrow_mut().take());"), "{out}");
+        assert!(out.contains("let __cap0_out = __SH_OUT.lock().unwrap().take();"), "{out}");
+        assert!(out.contains("*__SH_STDIN.lock().unwrap() = __cap0_in;"), "{out}");
+        assert!(out.contains("let mut __s = String::from_utf8_lossy(&__cap0_buf).to_string();"), "{out}");
+        // the emitted strip loop carries the SAME char literal as the helper
+        assert!(out.contains("while __s.ends_with('\\n') { __s.pop(); }"), "{out}");
+        assert!(!out.contains("__sh_cap_begin();"), "{out}");
+        assert!(!out.contains("__sh_cap_end(__cap_state"), "{out}");
+        // the body between the markers is untouched
+        assert!(out.contains("let x = 1;"), "{out}");
+
+        // nested sites pair LIFO and get distinct gensym indices
+        let nested = format!(
+            "{def}fn main() {{\nlet __cap_state = __sh_cap_begin();\nlet y = {{\nlet __cap_state = __sh_cap_begin();\nlet __s = __sh_cap_end(__cap_state, false);\n__s\n}};\nlet __s = __sh_cap_end(__cap_state, false);\n}}\n"
+        );
+        let out = super::inline_cap_pairs(&nested);
+        assert!(out.contains("__cap0_outf") && out.contains("__cap1_outf"), "{out}");
+        assert!(!out.contains("__cap_state"), "{out}");
+
+        // a via_ret=true end refuses the WHOLE file (not just that site)
+        let tru = format!(
+            "{def}fn main() {{\nlet __cap_state = __sh_cap_begin();\nlet __s = __sh_cap_end(__cap_state, true);\n}}\n"
+        );
+        assert_eq!(super::inline_cap_pairs(&tru), tru);
+
+        // an unbalanced end refuses (LIFO stack non-empty or pop on empty)
+        let unbal = format!("{def}fn main() {{\nlet __s = __sh_cap_end(__cap_state, false);\n}}\n");
+        assert_eq!(super::inline_cap_pairs(&unbal), unbal);
+        let unclosed = format!("{def}fn main() {{\nlet __cap_state = __sh_cap_begin();\n}}\n");
+        assert_eq!(super::inline_cap_pairs(&unclosed), unclosed);
+
+        // an unknown def body refuses every site (fingerprint gate)
+        let alien = "fn __sh_cap_begin() -> __ShCapState { todo!() }\nfn __sh_cap_end(st: __ShCapState, via_ret: bool) -> String { todo!() }\nlet __cap_state = __sh_cap_begin();\nlet __s = __sh_cap_end(__cap_state, false);\n";
+        assert_eq!(super::inline_cap_pairs(alien), alien);
+
+        // the def lines themselves are never touched
+        assert!(out.contains("fn __sh_cap_begin()"), "{out}");
+        assert!(out.contains("fn __sh_cap_end("), "{out}");
+    }
