+        // unknown body / missing body → refuse everything
+        let alien = "fn __sh_print_words(ws: &[Vec<String>], nl: bool, esc: bool) { todo!() }\n__sh_print_words(&x, false, false);\n";
+        assert_eq!(super::inline_print_words_calls(alien), alien);
+        let lone = "__sh_print_words(&x, false, false);\n";
