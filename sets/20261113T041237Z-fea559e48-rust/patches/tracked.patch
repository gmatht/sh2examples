+    /// The puts body inlines with no `return` left (arm boundaries), the
+    /// argument bound ONCE as `&str`, and the three-way route intact —
+    /// but ONLY when this text's own definition is the known body; the
+    /// fold refuses everything else.
+    #[test]
+    fn puts_inlines_the_router_without_returns() {
+        let def = format!("fn __sh_puts(s: &str) {}\n", super::PUTS_FP);
+        let src = format!("{def}__sh_puts(&format!(\"n={{}}\\n\", n));\n");
+        let out = super::inline_puts_calls(&src);
+        let call_line = out.lines().find(|l| l.contains("let __t")).unwrap();
+        assert!(!call_line.contains("__sh_puts"), "{call_line}");
+        assert!(!call_line.contains("return"), "{call_line}");
+        assert!(call_line.contains("let __t: &str = {&format!(\"n={}\\n\", n)};"), "{call_line}");
+        assert!(call_line.contains("write_all(f, __t.as_bytes())"), "{call_line}");
+        assert!(call_line.contains("b.extend_from_slice(__t.as_bytes())"), "{call_line}");
+        assert!(call_line.contains("print!(\"{}\", __t)"), "{call_line}");
+        // the definition line itself is never folded
+        assert!(out.contains(&def), "def mangled:\n{out}");
+
+        // no definition in the text → REFUSE (never guess a body)
+        let lone = "__sh_puts(&x);\n";
+        assert_eq!(super::inline_puts_calls(lone), lone);
+        // an UNKNOWN definition → REFUSE every call in the text
+        let alien = "fn __sh_puts(s: &str) { todo!() }\n__sh_puts(&x);\n";
+        assert_eq!(super::inline_puts_calls(alien), alien);
+        // a call whose argument does not close on the line keeps the helper
+        let split = format!("{def}__sh_puts(&foo(\n    x));\n");
+        let out = super::inline_puts_calls(&split);
+        assert!(out.contains("__sh_puts(&foo("), "{out}");
