+    /// the quote helper inlines its whole body as an expression block —
+    /// argument bound once in the parameter's coercion position (a
+    /// `&String`/`&format!` temporary extends through the block),
+    /// block-scoped accumulator and loop variable so nested/repeated
+    /// inlines cannot collide — and a non-fingerprinting definition
+    /// refuses every site.
+    #[test]
+    fn q_inlines_its_body_at_single_line_sites() {
+        let def = r#"fn __sh_q(s: &str) -> String {
+    let mut o = String::with_capacity(s.len() + 8);
+    o.push('\'');
+    for c in s.chars() {
+        if c == '\'' { o.push_str("'\\''"); } else { o.push(c); }
+    }
+    o.push('\'');
+    o
+}
+"#;
+        let src = format!(
+            "{def}fn main() {{\n    let w = \"x\";\n    let a = __sh_q(w);\n    let b = __sh_q(&__SHV_tmpf.with(|v| v.borrow().clone()));\n}}\n"
+        );
+        let out = super::inline_q_calls(&src);
+        assert!(out.contains("let __t: &str = {w};"), "{out}");
+        assert!(
+            out.contains("let __t: &str = {&__SHV_tmpf.with(|v| v.borrow().clone())};"),
+            "{out}"
+        );
+        assert!(out.contains("for __c in __t.chars()"), "{out}");
+        // the emitted push_str carries the SAME escaped literal as the
+        // helper's own — derived from the fixture, so the two cannot
+        // drift through source-escaping
+        let esc = def
+            .split("o.push_str(")
+            .nth(1)
+            .unwrap()
+            .split(");")
+            .next()
+            .unwrap();
+        assert!(out.contains(&format!("__o.push_str({esc});")), "{out}");
+        // the comparison char literal too — a single backslash there
+        // emits `'''`, which rustc rejects
+        let cmp = def.split("if c == ").nth(1).unwrap().split(' ').next().unwrap();
+        assert!(out.contains(&format!("if __c == {cmp} {{")), "{out}");
+        assert!(!out.contains("__sh_q(w)"), "{out}");
+        assert!(out.contains("fn __sh_q(s: &str)"), "{out}");
+
+        // an unknown body refuses every site
+        let alien = "fn __sh_q(s: &str) -> String { todo!() }\nlet x = __sh_q(w);\n";
+        assert_eq!(super::inline_q_calls(alien), alien);
+        // a call whose arguments span lines refuses (scanner contract)
+        let split = format!("{def}let x = __sh_q(\n    w);\n");
+        assert!(super::inline_q_calls(&split).contains("__sh_q("));
+    }
+
+    /// print_words inlines per its CLASSIFIED body: canonical (esc
+    /// evaluated-and-ignored, route), esc-aware (the arm resolved from
+    /// the static argument — and a DYNAMIC esc refuses), route-less
+    /// (direct print, no sink statics). Fixtures are composed from the
+    /// same atoms `classify_print_words` matches, so the matrix and the
+    /// inline cannot drift apart.
+    #[test]
+    fn print_words_inlines_per_classified_variant() {
+        let params = "fn __sh_print_words(ws: &[Vec<String>], nl: bool, esc: bool) ";
+        let body_ignore = |tail: &str| {
+            format!(
+                "{{ {} {} {} {tail} }}",
+                super::PW_ESC_IGNORE,
+                super::PW_CORE,
+                super::PW_NL
+            )
+        };
+        let body_apply = |tail: &str| {
+            format!(
+                "{{ {} {} {} {tail} }}",
+                super::PW_CORE,
+                super::PW_ESC_ARM,
+                super::PW_NL
+            )
+        };
+        // canonical: esc ignored, routed
+        let def = format!("{params}{}\n", body_ignore(super::PW_ROUTE));
+        let src = format!("{def}__sh_print_words(&[vec![\"hi\".to_string()]], true, false);\n");
+        let out = super::inline_print_words_calls(&src);
+        let call_line = out.lines().find(|l| l.contains("let __w")).unwrap();
+        assert!(!call_line.contains("__sh_print_words"), "{call_line}");
+        assert!(!call_line.contains("return"), "{call_line}");
+        assert!(call_line.contains("let __nl = {true};"), "{call_line}");
+        assert!(call_line.contains("let _ = {false};"), "{call_line}");
+        assert!(
+            call_line.contains("if __SH_ARITH_WORD_FAIL.swap(false, Ordering::SeqCst) { } else {"),
+            "{call_line}"
+        );
+        assert!(call_line.contains("if __nl { __s.push('\\n'); }"), "{call_line}");
+        assert!(call_line.contains("write_all(f, __s.as_bytes())"), "{call_line}");
+        assert!(!call_line.contains("__sh_echo_esc"), "{call_line}");
+
+        // esc-aware + esc=true → the unescape arm fires at the site;
+        // esc=false → no arm; a DYNAMIC esc refuses the fold entirely
+        let esc_def = format!("{params}{}\n", body_apply(super::PW_ROUTE));
+        let echo_def = "fn __sh_echo_esc(s: &str) -> String { s.to_string() }\n";
+        let on = format!("{esc_def}{echo_def}__sh_print_words(&[vec![x.clone()]], false, true);\n");
+        let out = super::inline_print_words_calls(&on);
+        let call_line = out.lines().find(|l| l.contains("let __w")).unwrap();
+        assert!(call_line.contains("__s = __sh_echo_esc(&__s);"), "{call_line}");
+        let off = format!("{esc_def}{echo_def}__sh_print_words(&[vec![x.clone()]], false, false);\n");
+        let out = super::inline_print_words_calls(&off);
+        assert!(!out.contains("__s = __sh_echo_esc"), "{out}");
+        let dyn_esc = format!("{esc_def}{echo_def}__sh_print_words(&[vec![x.clone()]], false, use_esc);\n");
+        assert_eq!(super::inline_print_words_calls(&dyn_esc), dyn_esc);
+
+        // apply+direct (every `echo -e`-only program): arm + direct print
+        let ed_def = format!("{params}{}\n", body_apply(super::PW_DIRECT));
+        let src = format!("{ed_def}{echo_def}__sh_print_words(&[vec![x.clone()]], false, true);\n");
+        let out = super::inline_print_words_calls(&src);
+        let call_line = out.lines().find(|l| l.contains("let __w")).unwrap();
+        assert!(call_line.contains("__s = __sh_echo_esc(&__s);"), "{call_line}");
+        assert!(call_line.contains("print!(\"{}\", __s);"), "{call_line}");
+        assert!(!call_line.contains("__SH_OUTFILE_TL"), "{call_line}");
+
+        // route-less: the direct printer, with NO sink statics in the fold
+        let direct_def = format!("{params}{}\n", body_ignore(super::PW_DIRECT));
+        let src = format!("{direct_def}__sh_print_words(&[vec![\"hi\".to_string()]], false, false);\n");
+        let out = super::inline_print_words_calls(&src);
+        let call_line = out.lines().find(|l| l.contains("let __w")).unwrap();
+        assert!(call_line.contains("print!(\"{}\", __s);"), "{call_line}");
+        assert!(!call_line.contains("__SH_OUTFILE_TL"), "{call_line}");
