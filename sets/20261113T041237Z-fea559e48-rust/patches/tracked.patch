+    /// the word-quote builder inlines its whole body as an expression block —
+    /// argument evaluated once in the for head (the slice temporary extends
+    /// through the loop), block-scoped accumulator. A multi-line argument
+    /// span folds too (`fold_span_calls` embeds it verbatim); a non-
+    /// fingerprinting definition or never-closing tail refuses. The inlined
+    /// quote blocks are then folded by the q pass, pipeline ordering.
+    #[test]
+    fn wq_inlines_whole_body_and_refuses() {
+        // The canonical registry bodies, byte-for-byte: the fingerprint
+        // constant can never drift from what the preamble emits, and the
+        // 15/15 corpus defs are the same body the renderer prints.
+        let def = format!(
+            "{}\n{}",
+            super::helper_source("q"),
+            super::helper_source("wq")
+        );
+        assert_eq!(
+            super::helper_fingerprint(&def, "__sh_wq"),
+            Some(super::WQ_FP.to_string()),
+            "WQ_FP must be the canonical wq body"
+        );
+
+        let src = format!(
+            "{def}fn main() {{\n    let v = vec![\"a\".to_string()];\n    let s = __sh_wq(&v);\n}}\n"
+        );
+        // Pipeline order: wq first (so its fingerprint sees the untouched
+        // `__sh_q(w)`), then q — which folds the very quote block the wq
+        // inline just emitted. Defs are left for prune_unused_helpers.
+        let out = super::inline_q_calls(&super::inline_wq_calls(&src));
+        assert!(
+            !out.contains("__sh_wq(&v"),
+            "single-line site must inline: {out}"
+        );
+        assert!(
+            !out.contains("__sh_q(__w)"),
+            "q pass must fold the quote block the wq inline emitted: {out}"
+        );
+        assert!(
+            out.contains("for (__i, __w) in {&v}.iter()"),
+            "argument lands in the for head: {out}"
+        );
+        assert!(out.contains("fn __sh_wq("), "defs belong to the prune: {out}");
+
+        // Multi-line argument span: fold it too — `fold_span_calls`
+        // scans the whole text and embeds the argument verbatim.
+        let multi = format!(
+            "{def}fn main() {{\n    __sh_wq(&[\n        \"a\".to_string(),\n    ]);\n}}\n"
+        );
+        let folded = super::inline_wq_calls(&multi);
+        assert!(folded.contains("__sh_wq(") == false || folded.contains("fn __sh_wq("), "{folded}");
+        assert!(
+            folded.contains("for (__i, __w) in {&["),
+            "multi-line arg must inline: {folded}"
+        );
+
+        // A tail that never closes: the scan breaks, bytes preserved.
+        let never = format!("{def}fn main() {{\n    __sh_wq(&[\n        \"a\".to_string(),\n");
+        assert_eq!(super::inline_wq_calls(&never), never);
+
+        // Non-fingerprinting definition: refuse every site.
+        let bad = "fn __sh_wq(ws: &[String]) -> String { String::new() }\nfn main() { __sh_wq(&[]); }\n";
+        assert_eq!(super::inline_wq_calls(bad), bad);
+    }
+
+    /// §5.7: the REPLACEMENT operand of `${v/pat/repl}` carries the
+    /// SOURCE's backslashes and gets exactly ONE level removed (pairwise,
+    /// left to right — the measured-bash table the core perl test pins);
+    /// the PATTERN is left untouched for its glob consumer. And the
+    /// native `.replace` fold must refuse a backslashed pattern: the
+    /// helper matches through fnmatch, whose `\X` IS that removal, while
+    /// a native replace would search for the raw two-char sequence and
+    /// silently match nothing (the 062 failure).
+    #[test]
+    fn subst_replacement_consumes_one_escape_level() {
+        let mut r = super::Render::default();
+        let s = |t: &str| {
+            super::IrExpr::Str(t.to_string(), crate::ir::StrStyle::DoubleQuoted)
+        };
+        // the measured table: one shell escape in, one escape out
+        assert_eq!(r.param_repl_str(&s(r"\c")), r#""c".to_string()"#);
+        assert_eq!(r.param_repl_str(&s(r"\\c")), r#""\\c".to_string()"#);
+        assert_eq!(r.param_repl_str(&s(r"\\\c")), r#""\\c".to_string()"#);
+        assert_eq!(r.param_repl_str(&s(r"\\\\c")), r#""\\\\c".to_string()"#);
+        assert_eq!(r.param_repl_str(&s(r"\x")), r#""x".to_string()"#);
+        // `\"` — the 062 replacement — denotes the two chars `\"`
+        assert_eq!(r.param_repl_str(&s(r#"\\\""#)), r#""\\\"".to_string()"#);
+        // a trailing backslash has nothing to escape and stays
+        assert_eq!(r.param_repl_str(&s(r#"ab\"#)), r#""ab\\".to_string()"#);
+        // backslash-free text is identity
+        assert_eq!(r.param_repl_str(&s("plain")), r#""plain".to_string()"#);
+
+        // The native `.replace` fold: a glob-free literal pattern folds…
+        let ok = r#"let x = __sh_replace(&v, "ab", "cd", true);"#;
+        assert!(
+            super::inline_sh_replace(ok).contains(r#"v.replace("ab", "cd")"#),
+            "glob-free literal still folds: {ok}"
+        );
+        // …but a BACKSLASHED pattern refuses: fnmatch reads `\"` as an
+        // escaped quote (a literal `"`), the native replace would not.
+        let esc = r#"let x = __sh_replace(&v, "\"", "x", true);"#;
+        assert_eq!(super::inline_sh_replace(esc), esc);
+    }
+
+    /// `drop_length_i64_casts`: a non-negative length widened to i64 is
+    /// dropped ONLY where the consumer cannot observe the type —
+    /// `.to_string()` (same digits) or a compare against an integer
+    /// literal (identical relation either side). ARITH, a variable on the
+    /// other side, a `let` with further uses, and the helpers' own `->
+    /// i64` bodies keep their cast.
+    #[test]
+    fn length_i64_cast_drops_only_in_unobservable_consumers() {
+        let d = super::drop_length_i64_casts;
+        // .to_string() — direct and paren-wrapped
+        assert_eq!(
+            d("y.chars().count() as i64).to_string()"),
+            "y.chars().count()).to_string()"
+        );
+        assert_eq!(
+            d("(m.with(|v| v.borrow().len() as i64)).to_string()"),
+            "(m.with(|v| v.borrow().len())).to_string()"
+        );
+        // compare against an integer literal
+        assert_eq!(
+            d("m.with(|v| v.borrow().len() as i64) > 5"),
+            "m.with(|v| v.borrow().len()) > 5"
+        );
+        // ARITH consumer keeps the cast (usize + i64 would not compile)
+        assert_eq!(
+            d("let __n = x.len() as i64 + 1;"),
+            "let __n = x.len() as i64 + 1;"
+        );
+        // a compare against a VARIABLE keeps it (usize vs i64: E0308)
+        assert_eq!(d("x.len() as i64 > k"), "x.len() as i64 > k");
+        // a `let` binding with unknown uses keeps it
+        assert_eq!(
+            d("let __n = v.borrow().len() as i64;"),
+            "let __n = v.borrow().len() as i64;"
+        );
+        // the helper's own `-> i64` body keeps it
+        let helper = "fn __sh_len(s: &str) -> i64 {\n    s.chars().count() as i64\n}";
+        assert_eq!(d(helper), helper);
+    }
+
+    /// `slice_const_block`: constant bounds collapse to the cast-free
+    /// block — a NEGATIVE offset counts back from the end (bash's
+    /// `${@: -3}` = the LAST three params, measured), an absent length
+    /// (`i64::MIN` sentinel) runs to the end, and a dynamic bound or a
+    /// constant NEGATIVE length refuses (bash rejects the latter with
+    /// "substring expression < 0").
+    #[test]
+    fn slice_const_block_collapses_constant_bounds() {
+        let c = super::Render::slice_const_block;
+        // argv, positive offset, ABSENT length: `${@:3}` used to take the
+        // whole i64 dance because the collapse demanded both bounds
+        assert_eq!(
+            c("__SH_ARGV.lock().unwrap().clone()", "3", "i64::MIN", true, ".to_vec()"),
+            Some(
+                "{ let __v = __SH_ARGV.lock().unwrap().clone(); let __s = 2usize.min(__v.len()); __v[__s..].to_vec() }"
+                    .to_string()
+            )
+        );
+        // argv, NEGATIVE offset: the last three
+        assert_eq!(
+            c(
+                "__SH_ARGV.lock().unwrap().clone()",
+                "-3",
+                "i64::MIN",
+                true,
+                ".join(\" \")"
+            ),
+            Some(
+                "{ let __v = __SH_ARGV.lock().unwrap().clone(); let __s = __v.len().saturating_sub(3); __v[__s..].join(\" \") }"
+                    .to_string()
+            )
+        );
+        // both constant — the pre-existing two-mins shape, byte-identical
+        assert_eq!(
+            c("ARR", "2", "2", false, ".to_vec()"),
+            Some(
+                "{ let __v = ARR; let __s = 2usize.min(__v.len()); let __e = (__s + 2usize).min(__v.len()); __v[__s..__e].to_vec() }"
+                    .to_string()
+            )
+        );
+        // negative offset + constant length (array, 0-based)
+        assert_eq!(
+            c("ARR", "-2", "3", false, ".to_vec()"),
+            Some(
+                "{ let __v = ARR; let __s = __v.len().saturating_sub(2); let __e = (__s + 3usize).min(__v.len()); __v[__s..__e].to_vec() }"
+                    .to_string()
+            )
+        );
+        // a dynamic bound refuses; a constant NEGATIVE length refuses
+        assert_eq!(c("ARR", "i", "2", false, ".to_vec()"), None);
+        assert_eq!(c("ARR", "2", "-1", false, ".to_vec()"), None);
+    }
