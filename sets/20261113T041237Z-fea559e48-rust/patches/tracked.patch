+    /// A literal-pat fnmatch is equality; a single/double-star composition
+    /// of literals is the native str question — with the char-count bound
+    /// that keeps `P*S` from matching an overlapping shorter subject
+    /// (`fnmatch("i*86", "i86")` is true, `fnmatch("8*86", "86")` false).
+    /// The subject binds to `&str` once, so a temporary env read is safe.
+    #[test]
+    fn fnmatch_literal_fold_collapses_glob_free_patterns() {
+        let src = "if __sh_fnmatch(\"pattern\", &__sh_case0) {\n";
+        let out = super::fnmatch_literal_fold(src);
+        assert!(!out.contains("__sh_fnmatch"), "{out}");
+        assert!(out.contains("let __t: &str = {&__sh_case0};"), "{out}");
+        assert!(out.contains("__t == \"pattern\""), "{out}");
+
+        let src = "let m = __sh_fnmatch(\"i*86\", &__sh_case1);\n";
+        let out = super::fnmatch_literal_fold(src);
+        assert!(
+            out.contains(
+                "__t.starts_with(\"i\") && __t.ends_with(\"86\") && __t.chars().count() >= 3"
+            ),
+            "{out}"
+        );
+
+        let src = "let m = __sh_fnmatch(\"*.txt\", &s.clone());\n";
+        let out = super::fnmatch_literal_fold(src);
+        assert!(out.contains("__t.ends_with(\".txt\")"), "{out}");
+
+        let src = "let m = __sh_fnmatch(\"*--view*\", &x);\n";
+        let out = super::fnmatch_literal_fold(src);
+        assert!(out.contains("__t.contains(\"--view\")"), "{out}");
+
+        let src =
+            "let m = __sh_fnmatch(\"?*\", &std::env::var(\"B\").unwrap_or_default());\n";
+        let out = super::fnmatch_literal_fold(src);
+        assert!(out.contains("!__t.is_empty()"), "{out}");
+
+        let src = "let m = __sh_fnmatch(\"*\", &x);\n";
+        let out = super::fnmatch_literal_fold(src);
+        assert!(out.contains("!__t.is_empty()"), "{out}");
+
+        let src = "let m = __sh_fnmatch(\"foo|bar\", &x);\n";
+        let out = super::fnmatch_literal_fold(src);
+        assert!(out.contains("__t == \"foo|bar\""), "{out}");
+    }
