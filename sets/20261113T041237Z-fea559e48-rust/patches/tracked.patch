+        assert!(out.contains("{&foo}.to_string()"), "{out}");
+
+        let src = "let x = __sh_stripsuf(&foo, \":*\", true);\n";
+        let out = super::strip_star_fold(src);
+        assert!(out.contains("__v.find(\":\")"), "{out}");
+        assert!(!out.contains("rfind"), "{out}");
+
+        // the empty prefix (bare `*`) finds at 0 / len, matching the
+        // helper's l = 0 / l = len base cases
+        let src = "let x = __sh_stripsuf(&foo, \"*\", false);\n";
+        let out = super::strip_star_fold(src);
+        assert!(out.contains("__v.rfind(\"\")"), "{out}");
+    }
+
+    /// Everything the fold refuses stays byte-identical: a dynamic
+    /// pattern, another glob metacharacter, the helper's own def line —
+    /// and, the reach-past hazard, a same-line `(\"lit\", bool)` that
+    /// belongs to a DIFFERENT call after an unfoldable stripsuf. A
+    /// paren-heavy subject still folds (the scan is depth-balanced).
+    #[test]
+    fn strip_star_fold_refuses_everything_else() {
+        let paren =
+            "let p = __sh_stripsuf(&std::env::var(\"B\").unwrap_or_default(), \"/*\", false);\n";
+        let out = super::strip_star_fold(paren);
+        assert!(out.contains("rfind(\"/\")"), "{out}");
+
+        let dynamic = "let x = __sh_stripsuf(&foo, &pat, false);\n";
+        assert_eq!(super::strip_star_fold(dynamic), dynamic);
+        let meta = "let x = __sh_stripsuf(&foo, \"a?*\", true);\n";
+        assert_eq!(super::strip_star_fold(meta), meta);
+        let def = "fn __sh_stripsuf(s: &str, pat: &str, greedy: bool) -> String {\n";
+        assert_eq!(super::strip_star_fold(def), def);
+        // the tail `\"x\", true)` belongs to g(), not to the unfoldable
+        // call — a regex would have wrapped it in the fold block
+        let past = "let a = __sh_stripsuf(&foo, &pat, false); g(\"x\", true)\n";
+        assert_eq!(super::strip_star_fold(past), past);
+        // a call whose args do not close on the line is left alone
+        let split = "let a = __sh_stripsuf(&foo, \n    \"o*\", false);\n";
+        assert_eq!(super::strip_star_fold(split), split);
+    }
+
+    /// A nested call stays inside the subject's block — evaluated once, as
+    /// the helper's own argument would be — while the outer call folds.
+    #[test]
+    fn strip_star_fold_keeps_nested_calls_intact() {
+        let src =
+            "let x = __sh_stripsuf(&__sh_stripsuf(&a, \"x*\", false), \"y*\", true);\n";
+        let out = super::strip_star_fold(src);
+        assert_eq!(out.matches("__sh_stripsuf(").count(), 1, "{out}");
+        assert!(out.contains("__sh_stripsuf(&a, \"x*\", false)"), "{out}");
+        assert!(out.contains("__v.find(\"y\")"), "{out}");
+    }
+
+    /// The strippre mirror: a `*S` pattern asks whether a prefix ENDS with
+    /// S, so the shortest match ends at the leftmost occurrence (`find`) —
+    /// greedy, the longest, at the rightmost (`rfind`). The empty S (bare
+    /// `*`) lands on the helper's l = 0 / l = len base cases via
+    /// find("")/rfind("").
+    #[test]
+    fn strip_star_pref_fold_collapses_star_suffix_patterns() {
+        let src = "let b = __sh_strippre(&filename.clone(), \"*.\", true);\n";
+        let out = super::strip_star_pref_fold(src);
+        assert!(!out.contains("__sh_strippre"), "{out}");
+        assert!(out.contains("__v.rfind(\".\")"), "{out}");
+        assert!(out.contains("__v[__i + \".\".len()..]"), "{out}");
+
+        let src = "let b = __sh_strippre(&s, \"*:\", false);\n";
+        let out = super::strip_star_pref_fold(src);
+        assert!(out.contains("__v.find(\":\")"), "{out}");
+
+        let src = "let b = __sh_strippre(&s, \"*\", false);\n";
+        let out = super::strip_star_pref_fold(src);
+        assert!(out.contains("__v.find(\"\")"), "{out}");
+
+        // a bracket class in S keeps the helper — and so does a second star
+        let src = "let b = __sh_strippre(&p, \"*[/\\\\]\", true);\n";
+        assert_eq!(super::strip_star_pref_fold(src), src);
+        let src = "let b = __sh_strippre(&p, \"*.*\", true);\n";
+        assert_eq!(super::strip_star_pref_fold(src), src);
+    }
