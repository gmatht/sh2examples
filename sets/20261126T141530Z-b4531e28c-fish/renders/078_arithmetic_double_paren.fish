#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
set i (math --scale 0 "2")
printf '%s\n' "i=$i"
set j (math --scale 0 "$(set -g i__sh2v $i; set -g i (math --scale 0 $i + 1); printf %s $i__sh2v) + $(set -g i__sh2v (math --scale 0 $i + 1); set -g i $i__sh2v; printf %s $i__sh2v)")
printf '%s\n' "j=$j"
