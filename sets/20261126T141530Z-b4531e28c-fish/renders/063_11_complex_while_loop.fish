#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

set input_file (begin
mktemp
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
set max_lines 3
set counter 0
printf '%s' '# comment
has $(sub) here
plain line
${param} line
' >"$input_file"
begin
    set __ps_tmp0 "$(mktemp)"
    grep -v ^# "$input_file" | head -n 3 >$__ps_tmp0
    while begin; IFS='' true
read line && [ -n "$line" ] && [ (math --scale 0 "$counter") -lt (math --scale 0 "$max_lines") ]; end
if printf '%s\n' ""$line"" | grep -Eq '^[[:space:]]*#'; continue
end
if string match -rq '.*\\$\\(.*\\).*' -- "$line"; printf '%s\n' "Contains command substitution: $line"; else if string match -rq '.*\\$\\{[^}].*\\}.*' -- "$line"; printf '%s\n' "Contains parameter expansion: $line"; else if string match -rq '.*\\$\\(\\(.*\\)\\).*' -- "$line"; printf '%s\n' "Contains arithmetic expansion: $line"; end
begin; set -l counter__sh2old $counter; set counter (math --scale 0 "$counter + 1"); test $counter__sh2old -ne 0; end
end <$__ps_tmp0
    set -l _ps_rc $status
    rm -f $__ps_tmp0
    test $_ps_rc -eq 0
end
rm -f "$input_file"
