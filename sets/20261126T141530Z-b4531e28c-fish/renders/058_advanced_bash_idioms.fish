#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_has
    # is COMMAND on the PATH? (fish treats an unknown
    # command inside a substitution as a fatal read error)
    type -q -- $argv[1]
end

function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

printf '%s\n' '=== Advanced Bash Idioms Examples ==='
printf '%s\n' ''
printf '%s\n' '1. Nested loops with conditional logic and array manipulation:'
set numbers 1 2 3 4 5
set letters a b c d e
for num in $numbers
    for letter in $letters
        if [ "$num" -gt 3 ] && [ "$letter" != "c" ]
            printf '%s\n' "  Number $num with letter $letter (filtered)"
        end
    end
end
printf '%s\n' ''
printf '%s\n' '2. Function with nested case statements and parameter expansion:'
function process_data
    set -l data_type "$argv[1]"
    set -l value "$argv[2]"
    switch "$data_type"
        case 'string'
            switch (if __sh2_has string; string lower -- "$value"; end)
                case 'hello' 'hi'
                    echo "  Greeting detected: $value"
                case 'bye' 'goodbye'
                    echo "  Farewell detected: $value"
                case '*'
                    echo "  Unknown string: $value"
            end
        case 'number'
            if printf '%s\n' ""$value"" | grep -Eq '^[0-9]+$'
                if [ (math --scale 0 "$value % 2") -eq (math --scale 0 "0") ]
                    echo "  Even number: $value"
                else
                    echo "  Odd number: $value"
                end
            else
                echo "  Invalid number: $value"
            end
        case '*'
            echo "  Unknown data type: $data_type"
    end
end
echo (process_data string Hello)
echo (process_data string Bye)
echo (process_data number 42)
echo (process_data number 17)
printf '%s\n' ''
printf '%s\n' '3. Complex conditional with command substitution and arithmetic:'
set file_count (begin
