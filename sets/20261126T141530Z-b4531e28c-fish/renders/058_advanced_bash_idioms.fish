end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
set dir_count (begin
find . -maxdepth 1 -type d | wc -l
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
if [ "$file_count" -gt 0 ] && [ "$dir_count" -gt 1 ]
    if [ (math --scale 0 "$file_count") -gt (math --scale 0 "$dir_count") ]
        printf '%s\n' "  More files ($file_count) than directories ($dir_count)"
    else
        if [ (math --scale 0 "$file_count") -eq (math --scale 0 "$dir_count") ]
            printf '%s\n' "  Equal count: $file_count files and $dir_count directories"
        else
            printf '%s\n' "  More directories ($dir_count) than files ($file_count)"
        end
    end
else
    printf '%s\n' '  Insufficient items for comparison'
end
