#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

set d (begin
mktemp -d
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
cd "$d" || exit 1
printf '%s\n' '=== Complex Backtick Examples ==='
set nested_result (begin
printf '%s\n' (string join '' -- "Three wells: " (begin
yes well | head -3
end))
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Nested backticks: $nested_result"
set count (begin
ls -1 | sort | wc -l
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "File count: $count"
if [ "root" = "root" ]
    printf '%s\n' 'Running as root'
else
    printf '%s\n' 'Not running as root'
end
switch Darwin
    case 'Linux'
        echo 'Running on Linux'
    case 'Darwin'
        echo 'Running on macOS'
    case '*'
        echo 'Running on other system'
end
function get_file_size
    set -l file "$argv[1]"
    set -l size $(wc -c <"$file")
    printf '%s\n' "File $file has $size bytes"
end
get_file_size 000__01_file_directory_operations.sh
set files (string split " " -- $(ls -1 *.sh examples/*.sh 2>/dev/null | sort
test $pipestatus[1] -eq 0))
printf '%s\n' (string join '' -- "Shell scripts found: " (count $files))
for file in $files
    printf '%s\n' "  - $file"
end
printf '%s' 'apple
banana
cherry
' > file1.txt
printf '%s' 'banana
cherry
date
' > file2.txt
set process_result (begin
begin 
set __ps_tmp0 "$(mktemp)"
sort file1.txt >$__ps_tmp0
set __ps_tmp1 "$(mktemp)"
sort file2.txt >$__ps_tmp1
comm -23 $__ps_tmp0 $__ps_tmp1 && rm -f $__ps_tmp0 $__ps_tmp1
end
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'Process substitution result:'
printf '%s\n' "$process_result"
set here_string_result (begin
printf '%s\n' 'hello world' | tr a-z A-Z
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Here string result: $here_string_result"
set perl_result (begin
perl -e 'print "Hello from Perl\\n"'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Perl result: $perl_result"
rm -f file1.txt file2.txt
printf '%s\n' '=== Complex Backtick Examples Complete ==='
cd /
rm -r -f "$d"
