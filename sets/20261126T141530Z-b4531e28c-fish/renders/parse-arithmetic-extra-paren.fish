#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function _num --argument val
    # bash coerces non-numeric arith values to 0; fish math errors
    if string match -qr -- '^-?[0-9]+$' $val
        echo $val
    else
        echo 0
    end
end

set x (math --scale 0 "(($(_num $a) + $(_num $b)) / ($(_num $c) + $(_num $d)))")
printf '%s' "x=[$x]
"
