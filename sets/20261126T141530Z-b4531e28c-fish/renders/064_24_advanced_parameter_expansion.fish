#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
set input (test -n "$argv[1]"; and printf '%s' "$argv[1]"; or printf '%s' "default_value")
set sanitized (string replace -a '[^a-zA-Z0-9]' '_' -- "$input")
set uppercase (string upper -- "$sanitized")
printf '%s\n' "Input: '$input' -> Sanitized: '$sanitized' -> Uppercase: '$uppercase'"
