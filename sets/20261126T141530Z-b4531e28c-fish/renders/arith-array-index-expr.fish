#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
set arr 10 20 30
set i 1
printf '%s\n' (math --scale 0 "($(set -l _i (math --scale 0 "$i + 1"); printf '%s' $arr[$_i]) * 2)")
printf '%s\n' (math --scale 0 "($arr[1] + $arr[3])")
printf '%s\n' (math --scale 0 "bitand(($arr[2] + $arr[3]), 50)")
