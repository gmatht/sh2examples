#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

grep pattern /dev/null || echo 'No matches found'
echo 'HELLO world' | grep -i hello
printf '%b\n' 'line1\\nline2\\nline3' | grep -v line2
printf '%b\n' 'first\\nsecond\\nthird' | grep -n second
printf '%b\n' 'match\\nno match\\nmatch again' | grep -c match
echo 'text with pattern123 in it' | grep -o 'pattern[0-9]\\+'
set matched (begin
printf '%s\n' test | grep -c '.*'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "  grep_exit: $status"
printf '%s\n' "  match_count: $matched"
