#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

set u
function capture
    set -l label "$argv[1]"
    set -e argv[1]
    begin
        set -l tmp_stdout
        set -l tmp_stderr
    end
    set tmp_stdout (begin
mktemp /tmp/readonly_demo_stdout_XXXXXX
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
    set tmp_stderr (begin
mktemp /tmp/readonly_demo_stderr_XXXXXX
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
    $argv >"$tmp_stdout" 2>"$tmp_stderr"
    set -l ec (string match -ar '[^ \t\n]+' -- $status)
    set -l so
    set so (begin
cat "$tmp_stdout"
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
    set -l se
    set se (begin
cat "$tmp_stderr"
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
    rm -f "$tmp_stdout" "$tmp_stderr"
    printf '%s\n' "--- [$label] ---"
    printf '%s\n' "  cmd     : $argv"
    printf '%s\n' "  exitcode: $ec"
    if [ "$so" != "" ]
        printf '%s\n' "  stdout  : $so"
    end
    if [ "$se" != "" ]
        printf '%s\n' "  stderr  : $se"
    end
    printf '%s\n' ''
    return "$ec"
end
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 1: Basic readonly variable'
printf '%s\n' '============================================================'
capture 01-readonly-var bash -c '
        readonly MY_VAR="hello_world"
        echo "MY_VAR=${MY_VAR}"
        # Attempt to change it (will fail, but we capture)
        MY_VAR="changed" 2>/dev/null || echo "Assignment denied: $?"
        echo "MY_VAR after attempted change=${MY_VAR}"
    '
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 2: readonly -p  (print readonly variables)'
printf '%s\n' '============================================================'
capture 02-readonly-p bash -c '
        readonly FOO=alpha
        readonly BAR=beta
        readonly -p | head -5
    '
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 3: readonly -f  (readonly functions)'
printf '%s\n' '============================================================'
capture 03-readonly-f bash -c '
        myfunc() { echo "Hello from myfunc"; }
        readonly -f myfunc
        myfunc
        # Attempt to unset the function (will fail)
        unset -f myfunc 2>/dev/null || echo "unset -f denied"
        # Verify function still exists
        myfunc
    '
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 4: readonly -a  (indexed array)'
printf '%s\n' '============================================================'
capture 04-readonly-a bash -c '
        declare -a MY_ARR=(zero one two)
        readonly -a MY_ARR
        echo "MY_ARR[0]=${MY_ARR[0]}"
        echo "MY_ARR[1]=${MY_ARR[1]}"
        # Attempt to change an element (will fail)
        MY_ARR[0]=ZERO 2>/dev/null || echo "Array assignment denied"
        echo "MY_ARR[0] after attempt=${MY_ARR[0]}"
    '
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 5: readonly -A  (associative array)'
printf '%s\n' '============================================================'
capture 05-readonly-A bash -c '
        declare -A MY_ASSOC=([key1]=val1 [key2]=val2)
        readonly -A MY_ASSOC
        echo "MY_ASSOC[key1]=${MY_ASSOC[key1]}"
        echo "MY_ASSOC[key2]=${MY_ASSOC[key2]}"
        # Attempt to change (will fail)
        MY_ASSOC[key1]=CHANGED 2>/dev/null || echo "Assoc assignment denied"
        echo "MY_ASSOC[key1] after attempt=${MY_ASSOC[key1]}"
    '
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 6: readonly --  (no more options)'
printf '%s\n' '============================================================'
capture 06a-readonly-dash-ok bash -c '
        readonly -- MYVAR=hello
        echo "MYVAR=${MYVAR}"
        # Confirm it is indeed readonly
        MYVAR=world 2>/dev/null || echo "Assignment denied (expected)"
    '
capture 06b-readonly-dash-invalid bash -c '
        readonly -- -notvalid 2>&1 || true
    '
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 7: Invalid variable name (error case)'
printf '%s\n' '============================================================'
capture 07-invalid-name bash -c '
        readonly 123invalid 2>&1 || true
    '
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 8: readonly -f -p  (list readonly functions)'
printf '%s\n' '============================================================'
capture 08-readonly-f-p bash -c '
        f1() { :; }
        f2() { :; }
        readonly -f f1 f2
        readonly -f -p | head -5
    '
printf '%s\n' ''
printf '%s\n' 'All readonly demo sections completed.'
exit 0
