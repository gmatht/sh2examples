#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

printf '%b\n' 'line1\\nline2\\nTARGET\\nline4\\nline5' | grep -A 2 TARGET
printf '%b\n' 'line1\\nline2\\nTARGET\\nline4\\nline5' | grep -B 2 TARGET
printf '%b\n' 'line1\\nline2\\nTARGET\\nline4\\nline5' | grep -C 1 TARGET
set d (begin
mktemp -d
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
cd "$d" || exit 1
printf '%s' 'pattern in file1
' > temp_file1.txt
printf '%s' 'no pattern in file2
' > temp_file2.txt
printf '%s' 'pattern in file3
' > temp_file3.txt
printf '%s\n' 'Recursive search results:'
grep -r pattern $(find . -name '*.txt')
printf '%s\n' 'Result 2...'
grep -l pattern *.txt | sort
printf '%s\n' 'Result 3...'
grep -L pattern *.txt
cd /
rm -r -f "$d"
set matched (begin
printf '%s\n' test | grep -c '.*'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "  grep_exit: $status"
printf '%s\n' "  match_count: $matched"
