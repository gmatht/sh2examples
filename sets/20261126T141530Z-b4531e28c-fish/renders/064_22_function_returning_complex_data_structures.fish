#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function get_system_info
    :
    set info_os (begin
uname -s
end | string collect); set info_len (math --scale 0 "$info_len + 1"); set -a info_keys os
    set info_arch (begin
uname -m
end | string collect); set info_len (math --scale 0 "$info_len + 1"); set -a info_keys arch
    set info_hostname (begin
hostname
end | string collect); set info_len (math --scale 0 "$info_len + 1"); set -a info_keys hostname
    set info_user "$USER"; set info_len (math --scale 0 "$info_len + 1"); set -a info_keys user
    begin; for key in $info_keys; printf '%s\n' (string join '' -- "info[" $key "]=" (set -l _nk info_"$key"; printf '%s\n' "$$_nk"))
end; end | sort
end
get_system_info
