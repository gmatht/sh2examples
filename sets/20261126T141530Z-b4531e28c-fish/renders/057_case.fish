#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
printf '%s\n' '=== Basic Case Statement Example ==='
switch "$argv[1]"
    case 'start'
        echo 'Starting the service...'
    case 'stop'
        echo 'Stopping the service...'
    case 'restart'
        echo 'Restarting the service...'
    case '*'
        printf '%s\n' (string join '' -- "Usage: " (set -q SH2_ARGV0; and printf '%s' "$SH2_ARGV0"; or status filename) " {start|stop|restart}")
        exit 1
end
printf '%s\n' '=== Case Statement with Pattern Matching ==='
set filename "$argv[2]"
switch "$filename"
    case '*.txt'
        printf '%s\n' "Processing text file: $filename"
    case '*.sh'
        printf '%s\n' "Processing shell script: $filename"
    case '*.py'
        printf '%s\n' "Processing Python file: $filename"
    case '*'
        printf '%s\n' "Unknown file type: $filename"
end
printf '%s\n' '=== Case Statement with Multiple Patterns ==='
switch "$argv[3]"
    case 'help' 'h' '-h' '--help'
        echo 'Help information:'
        echo '  start  - Start the service'
        echo '  stop   - Stop the service'
        echo '  status - Show service status'
    case 'status' 's' '-s' '--status'
        echo 'Service status: Running'
    case '*'
        printf '%s\n' "Unknown option: $argv[3]"
end
printf '%s\n' '=== Case Statement with Character Classes ==='
switch "$argv[4]"
    case '[0-9]'
        printf '%s\n' "Single digit: $argv[4]"
    case '[a-z]'
        printf '%s\n' "Lowercase letter: $argv[4]"
    case '[A-Z]'
        printf '%s\n' "Uppercase letter: $argv[4]"
    case '[0-9][0-9]'
        printf '%s\n' "Two digit number: $argv[4]"
    case '*'
        printf '%s\n' "Other character: $argv[4]"
end
printf '%s\n' '=== Case Statement with Default Action ==='
switch "$argv[5]"
    case 'red'
        echo 'Color is red'
    case 'green'
        echo 'Color is green'
    case 'blue'
        echo 'Color is blue'
end
printf '%s\n' '=== Case Statement with Commands ==='
switch "$argv[6]"
    case 'ls'
        ls -l -a
    case 'date'
        date
    case 'pwd'
        pwd
    case 'whoami'
        whoami
    case '*'
        echo 'Available commands: ls, date, pwd, whoami'
end
