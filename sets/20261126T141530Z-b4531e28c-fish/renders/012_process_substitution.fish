#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
set u
printf '%s\n' '== Here-string with grep -o =='
echo "$(printf '%s
' 'some pattern here' | grep -o pattern)"
printf '%s\n' '== Process substitution with comm =='
begin
    set __ps_tmp0 "$(mktemp)"
    printf '%s' 'a
b
' > $__ps_tmp0
    set __ps_tmp1 "$(mktemp)"
    printf '%s' 'b
c
' > $__ps_tmp1
    comm -12 $__ps_tmp0 $__ps_tmp1
    set -l _ps_rc $status
    rm -f $__ps_tmp0 $__ps_tmp1
    test $_ps_rc -eq 0
end
printf '%s\n' '== readarray/mapfile =='
begin
    set __ps_tmp2 "$(mktemp)"
    printf '%s' 'x
y
' > $__ps_tmp2
    set -e lines
while read -l _mf_line
    set -a lines $_mf_line
end <$__ps_tmp2
    set -l _ps_rc $status
    rm -f $__ps_tmp2
    test $_ps_rc -eq 0
end
printf '%s ' (string join ' ' $lines)
printf '%s\n' ''
printf '%s\n' '== More process substitution examples =='
set __ps_tmp3 "$(mktemp)"
printf '%b\n' 'a\\nc\\nb' | sort >$__ps_tmp3
set __ps_tmp4 "$(mktemp)"
printf '%b\n' 'a\\nb\\nd' | sort >$__ps_tmp4
diff $__ps_tmp3 $__ps_tmp4 && rm -f $__ps_tmp3 $__ps_tmp4 || echo 'Files differ'
begin
    set __ps_tmp5 "$(mktemp)"
    printf '%s' 'name1
name2
' > $__ps_tmp5
    set __ps_tmp6 "$(mktemp)"
    printf '%s' 'value1
value2
' > $__ps_tmp6
    paste $__ps_tmp5 $__ps_tmp6
    set -l _ps_rc $status
    rm -f $__ps_tmp5 $__ps_tmp6
    test $_ps_rc -eq 0
end
