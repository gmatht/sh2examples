#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
begin
    export DEBUG=1
    export LOG_LEVEL=verbose
    begin
    set -g __sh2_sv_DEBUG $DEBUG; set -e DEBUG; set -l DEBUG $__sh2_sv_DEBUG
        set -e DEBUG
        printf '%s\n' (string join '' -- "Inner: LOG_LEVEL=" $LOG_LEVEL ", DEBUG=" (test -n "$DEBUG"; and printf '%s' "$DEBUG"; or printf '%s' "unset"))
    set -g DEBUG $__sh2_sv_DEBUG; set -e __sh2_sv_DEBUG
    end
    printf '%s\n' "Outer: LOG_LEVEL=$LOG_LEVEL, DEBUG=$DEBUG"
end
