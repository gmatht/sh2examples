#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function _num --argument val
    # bash coerces non-numeric arith values to 0; fish math errors
    if string match -qr -- '^-?[0-9]+$' $val
        echo $val
    else
        echo 0
    end
end

set y (math --scale 0 "$y + 2")
set -a z a b
set -a z (string sub --start 1 --length 1 -- "$primes")
printf '%s\n' '=== Prime Number Generator (first 1000 primes) ==='
function is_prime
    set -l n "$argv[1]"
    if [ "$n" -lt 2 ]
        return 1
    end
    if [ "$n" -eq 2 ]
        return 0
    end
    if [ (math --scale 0 "($(_num $n) % 2)") -eq 0 ]
        return 1
    end
    set -l sqrt_n $(printf '%s\n' "sqrt($n)" | bc)
    set -l i 3
    while [ "$i" -le "$sqrt_n" ]
        if [ (math --scale 0 "$n % $i") -eq 0 ]
            return 1
        end
        set i (math --scale 0 "($i + 2)")
    end
    return 0
end
printf '%s\n' 'Finding first 100 prime numbers...'
printf '%s\n' 'This may take a while...'
set primes 2
set count 1
set candidate 3
while [ "$count" -lt 100 ]
    if is_prime (string match -ar '[^ \t\n]+' -- $candidate)
        set -a primes (string match -ar '[^ \t\n]+' -- $candidate)
        set count (math --scale 0 "($count + 1)")
        if [ (math --scale 0 "($count % 10)") -eq 0 ]
            printf '%s\n' "Found $count primes so far..."
        end
    end
    set candidate (math --scale 0 "($candidate + 2)")
end
printf '%s\n' ''
printf '%s\n' 'First 1000 prime numbers found!'
printf '%s\n' (string join '' -- "Count: " (count $primes))
printf '%s\n' (string join '' -- "First 10: " (string join ' ' $primes[1..10]))
printf '%s\n' (string join '' -- "Last 10: " (string join ' ' $primes[-10..-1]))
printf '%s\n' 'Prime number generation complete!'
