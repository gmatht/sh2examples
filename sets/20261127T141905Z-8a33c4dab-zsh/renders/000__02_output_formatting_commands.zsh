#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- '=== Output and Formatting Commands ==='
print -r -- "Echo result: Hello from backticks"
print -r -- "Printf result: Number: 42, String: test"
print -r -- '=== Compression Commands ==='
print -r -- '=== Network Commands ==='
print -r -- '=== Process Management Commands ==='
d="$(mktemp -d)"
cd "$d" || exit 1
print -r -- '=== Checksum Commands ==='
printf '%s' 'test content
' > test_checksum.txt
sha256_result="$(sha256sum test_checksum.txt)"
print -r -- "SHA256 result: $sha256_result"
sha512_result="$(sha512sum test_checksum.txt)"
print -r -- "SHA512 result: $sha512_result"
strings_result="$(strings test_binary.txt | head -3)"
print -r -- 'Strings result:'
print -r -- "$strings_result"
print -r -- '=== I/O Redirection Commands ==='
tee_result="$(echo 'test output' | tee test_tee.txt)"
print -r -- "Tee result: $tee_result"
print -r -- '=== Perl Command ==='
perl_result="$(perl -e 'print "Hello from Perl\n"')"
print -r -- "Perl result: $perl_result"
rm -f test_checksum.txt test_tee.txt
cd /
rm -r -f "$d"
