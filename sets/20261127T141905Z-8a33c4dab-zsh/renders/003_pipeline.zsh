#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
d="$(mktemp -d)"
cd "$d" || exit 1
printf '%s' 'apple
apple
' > file.txt
printf '%s' 'hello.txt
' > note.txt
printf '%s' 'function f() { echo hi; }
' > s.sh
ls | sort | grep '\.txt$' | wc -l
print -r -- ''
cat file.txt | sort | uniq -c | sort -n -r
print -r -- ''
find . -name '*.sh' | xargs grep -l function | tr -d '\\/'
print -r -- ''
cat file.txt | tr a b | grep hello
print -r -- ''
cat file.txt | sort | grep hello
cd /
rm -r -f "$d"
