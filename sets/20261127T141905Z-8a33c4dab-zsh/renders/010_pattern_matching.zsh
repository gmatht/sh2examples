#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
set -e -u
print -r -- '== [[ pattern and regex ]]'
case "file.txt" in *.txt) : ;; *) false ;; esac && echo pattern-match
printf '%s\n' "file.txt" | grep -Eq '^file\.[a-z]+$' && echo regex-match
print -r -- '== extglob =='
:
case "file.js" in *.js) case "file.js" in *.min.js) false ;; *) : ;; esac ;; *) false ;; esac && echo f1-ok
case "thing.min.js" in *.js) case "thing.min.js" in *.min.js) false ;; *) : ;; esac ;; *) false ;; esac || echo f2-filtered
print -r -- '== nocasematch =='
:
case "Foo" in [fF][oO][oO]) : ;; *) false ;; esac && echo ci-match
