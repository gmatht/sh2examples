#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- '=== Basic Case Statement Example ==='
case "$1" in
    "start")
        echo 'Starting the service...'
    ;;
    "stop")
        echo 'Stopping the service...'
    ;;
    "restart")
        echo 'Restarting the service...'
    ;;
    *)
        print -r -- "Usage: $0 {start|stop|restart}"
        exit 1
    ;;
esac
print -r -- '=== Case Statement with Pattern Matching ==='
filename="$2"
case "$filename" in
    *.txt)
        print -r -- "Processing text file: $filename"
    ;;
    *.sh)
        print -r -- "Processing shell script: $filename"
    ;;
    *.py)
        print -r -- "Processing Python file: $filename"
    ;;
    *)
        print -r -- "Unknown file type: $filename"
    ;;
esac
print -r -- '=== Case Statement with Multiple Patterns ==='
case "$3" in
    "help" | "h" | "-h" | "--help")
        echo 'Help information:'
        echo '  start  - Start the service'
        echo '  stop   - Stop the service'
        echo '  status - Show service status'
    ;;
    "status" | "s" | "-s" | "--status")
        echo 'Service status: Running'
    ;;
    *)
        print -r -- "Unknown option: $3"
    ;;
esac
print -r -- '=== Case Statement with Character Classes ==='
case "$4" in
    [0-9])
        print -r -- "Single digit: $4"
    ;;
    [a-z])
        print -r -- "Lowercase letter: $4"
    ;;
    [A-Z])
        print -r -- "Uppercase letter: $4"
    ;;
    [0-9][0-9])
        print -r -- "Two digit number: $4"
    ;;
    *)
        print -r -- "Other character: $4"
    ;;
esac
print -r -- '=== Case Statement with Default Action ==='
case "$5" in
    "red")
        echo 'Color is red'
    ;;
    "green")
        echo 'Color is green'
    ;;
    "blue")
        echo 'Color is blue'
    ;;
esac
print -r -- '=== Case Statement with Commands ==='
case "$6" in
    "ls")
        ls -l -a
    ;;
    "date")
        date
    ;;
    "pwd")
        pwd
    ;;
    "whoami")
        whoami
    ;;
    *)
        echo 'Available commands: ls, date, pwd, whoami'
    ;;
esac
