#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- '=== Checksum Commands ==='
d="$(mktemp -d)"
cd "$d" || exit 1
printf '%s' 'test content
' > test_checksum.txt
sha256_result="$(sha256sum test_checksum.txt)"
print -r -- "SHA256 result: $sha256_result"
sha512_result="$(sha512sum test_checksum.txt)"
print -r -- "SHA512 result: $sha512_result"
strings_result="$(strings target/debug/debashc.exe | head -3)"
print -r -- 'Strings result:'
print -r -- "$strings_result"
rm -f test_checksum.txt
print -r -- '=== Checksum Commands Complete ==='
cd /
rm -r -f "$d"
