#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -- 'line1\nline2\nTARGET\nline4\nline5' | grep -A 2 TARGET
print -- 'line1\nline2\nTARGET\nline4\nline5' | grep -B 2 TARGET
print -- 'line1\nline2\nTARGET\nline4\nline5' | grep -C 1 TARGET
d="$(mktemp -d)"
cd "$d" || exit 1
printf '%s' 'pattern in file1
' > temp_file1.txt
printf '%s' 'no pattern in file2
' > temp_file2.txt
printf '%s' 'pattern in file3
' > temp_file3.txt
print -r -- 'Recursive search results:'
-r pattern $(find . -name '*.txt')
print -r -- 'Result 2...'
grep -l pattern *.txt | sort
print -r -- 'Result 3...'
grep -L pattern *.txt
cd /
rm -r -f "$d"
matched="$(printf '%s\n' test | grep -c '.*')"
print -r -- "  grep_exit: $?"
print -r -- "  match_count: $matched"
