#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
d="$(mktemp -d)"
cd "$d" || exit 1
print -r -- '=== Complex Backtick Examples ==='
nested_result="$(print -r -- "Three wells: $(yes well | head -3)")"
print -r -- "Nested backticks: $nested_result"
count="$(ls -1 | sort | wc -l)"
print -r -- "File count: $count"
if case ""root"" in "root") : ;; *) false ;; esac; then
    print -r -- 'Running as root'
else
    print -r -- 'Not running as root'
fi
case Darwin in
    Linux)
        echo 'Running on Linux'
    ;;
    Darwin)
        echo 'Running on macOS'
    ;;
    *)
        echo 'Running on other system'
    ;;
esac
get_file_size() {
    local file="$1"
    local size=$(wc -c <"$file")
    print -r -- "File $file has $size bytes"
}
get_file_size 000__01_file_directory_operations.sh
files=($(ls -1 *.sh examples/*.sh | sort 2>/dev/null))
print -r -- "Shell scripts found: ${#files[@]}"
for file in ${files[@]}; do
    print -r -- "  - $file"
done
printf '%s' 'apple
banana
cherry
' > file1.txt
printf '%s' 'banana
cherry
date
' > file2.txt
process_result="$(__ps_tmp0="$(mktemp)"; sort file1.txt >$__ps_tmp0; __ps_tmp1="$(mktemp)"; sort file2.txt >$__ps_tmp1; comm -23 $__ps_tmp0 $__ps_tmp1 && rm -f $__ps_tmp0 $__ps_tmp1)"
print -r -- 'Process substitution result:'
print -r -- "$process_result"
here_string_result="$(printf '%s\n' 'hello world' | tr a-z A-Z)"
print -r -- "Here string result: $here_string_result"
perl_result="$(perl -e 'print "Hello from Perl\n"')"
print -r -- "Perl result: $perl_result"
rm -f file1.txt file2.txt
print -r -- '=== Complex Backtick Examples Complete ==='
cd /
rm -r -f "$d"
