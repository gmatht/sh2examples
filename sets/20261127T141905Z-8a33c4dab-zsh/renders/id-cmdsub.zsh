#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS

setopt shwordsplit globsubst
set -u
capture() {
    local label="$1"
    shift
    {
        local tmp_stdout
        local tmp_stderr
    }
    tmp_stdout="$(mktemp /tmp/id_demo_stdout_XXXXXX)"
    tmp_stderr="$(mktemp /tmp/id_demo_stderr_XXXXXX)"
    "$@" >"$tmp_stdout" 2>"$tmp_stderr"
    local ec=${=?}
    local so
    so="$(cat "$tmp_stdout")"
    local se
    se="$(cat "$tmp_stderr")"
    rm -f "$tmp_stdout" "$tmp_stderr"
    print -r -- "--- ["$label"] ---"
    echo "  cmd     : $*"
    print -r -- "  exitcode: "$ec""
    if [ "$so" != "" ]; then
        print -r -- "  stdout  : "$so""
    fi
    if [ "$se" != "" ]; then
        print -r -- "  stderr  : "$se""
    fi
    print -r -- ''
    return "$ec"
}
print -r -- '============================================================'
print -r -- ' SECTION 1: '\''id'\'' (default — current process)'
print -r -- '============================================================'
capture 01-default id
print -r -- '============================================================'
print -r -- ' SECTION 2: id -u  (effective user ID, numeric)'
print -r -- '============================================================'
