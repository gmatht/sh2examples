#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
if case ""a"" in "a") : ;; *) false ;; esac; then
    print -r -- eq
fi
if case ""a"" in "a") false ;; *) : ;; esac; then
    print -r -- bad
else
    print -r -- ne
fi
if case ""a"" in "b") : ;; *) false ;; esac; then
    print -r -- bad
else
    print -r -- not-equal
fi
if case ""hello"" in "hello") : ;; *) false ;; esac; then
    print -r -- var-eq
fi
if case ""hello"" in "other") false ;; *) : ;; esac; then
    print -r -- var-ne
fi
if case ""10"" in "10") : ;; *) false ;; esac; then
    print -r -- num-eq
fi
if case ""10"" in "010") : ;; *) false ;; esac; then
    print -r -- bad
else
    print -r -- num-string-distinct
fi
