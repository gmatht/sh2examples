#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

printf '%s\n' '== Basic grep parameters =='
echo 'text with pattern' | grep -i PATTERN && echo '  -i match: OK' || echo '  -i match: FAIL'
set count (begin
printf '%b\n' 'line1\\nline2\\nline3' | grep -v line2 | wc -l
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "  -v count: $count (expected 2)"
set matched (begin
printf '%b\n' 'match\\nno match\\nmatch again' | grep -c match
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "  -c count: $matched (expected 2)"
printf '%s\n' '== Context parameters =='
printf '%b\n' 'line1\\nline2\\nTARGET\\nline4\\nline5' | grep -A 2 TARGET >/tmp/grep_out.txt
printf '%s\n' (string join '' -- "  -A 2 lines: " (begin
wc -l </tmp/grep_out.txt
end) " (expected 3)")
printf '%b\n' 'line1\\nline2\\nTARGET\\nline4\\nline5' | grep -B 2 TARGET >/tmp/grep_out.txt
printf '%s\n' (string join '' -- "  -B 2 lines: " (begin
wc -l </tmp/grep_out.txt
end) " (expected 3)")
printf '%b\n' 'line1\\nline2\\nTARGET\\nline4\\nline5' | grep -C 1 TARGET >/tmp/grep_out.txt
printf '%s\n' (string join '' -- "  -C 1 lines: " (begin
wc -l </tmp/grep_out.txt
end) " (expected 3)")
printf '%s\n' '== File handling parameters =='
printf '%s' 'content
' > /tmp/grep_file.txt
grep -c content /tmp/grep_file.txt && echo '  -c file: OK' || echo '  -c file: FAIL'
grep -l content /tmp/grep_file.txt && echo '  -l: found' || echo '  -l: not found'
grep -L nonexistent /tmp/grep_file.txt && echo '  -L: not found (correct)' || echo '  -L: found (wrong)'
printf '%s\n' '== Output formatting parameters =='
set matched "$(printf '%s
' 'text with pattern in it' | grep -o pattern)"
printf '%s\n' "  -o match: '$matched' (expected 'pattern')"
set lineno (begin
echo 'text with pattern in it' | grep -n pattern | cut -d : -f 1
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "  -n line: $lineno (expected 1)"
printf '%s\n' '== Recursive parameters =='
mkdir -p /tmp/grep_sub && echo 'subfile content' >/tmp/grep_sub/file.txt
set found (begin
grep -r subfile /tmp/grep_sub 2>/dev/null | wc -l
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "  -r recursive: $found files matched (expected 1)"
rm -r -f /tmp/grep_sub
printf '%s\n' '== Line length parameters =='
set longline (begin
printf '%s' aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "$longline" | grep -m 1 a >/dev/null && echo '  -m 1 (long line): OK' || echo '  -m 1 (long line): FAIL'
printf '%s\n' '== Word-regexp and line-regexp parameters =='
printf '%b\n' 'foo\\nfoobar\\nbar' | grep -w foo >/tmp/grep_out.txt
printf '%s\n' (string join '' -- "  -w word match lines: " (begin
wc -l </tmp/grep_out.txt
end) " (expected 1)")
rm -f /tmp/grep_file.txt /tmp/grep_out.txt
