function __sh2_has
    # is COMMAND on the PATH? (fish treats an unknown
    # command inside a substitution as a fatal read error)
    type -q -- $argv[1]
end

function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

function _num --argument val
    # bash coerces non-numeric arith values to 0; fish math errors
    if string match -qr -- '^-?[0-9]+$' $val
        echo $val
    else
        echo 0
    end
end

