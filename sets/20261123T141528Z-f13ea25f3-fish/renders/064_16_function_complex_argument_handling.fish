#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function process_files
    set files (string split " " -- $argv)
    set -l count 0
    for file in $files
        if [ -f "$file" ]
            begin
                set -l count__sh2old $count; set count (math --scale 0 "$count + 1"); test $count__sh2old -ne 0
            end
            printf '%s\n' "Processing: $file"
        end
    end
    printf '%s\n' "Total files processed: $count"
end
process_files file1.txt file2.txt nonexistent.txt
