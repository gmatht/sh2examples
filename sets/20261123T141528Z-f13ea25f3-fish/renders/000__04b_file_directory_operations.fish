#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

printf '%s\n' '=== File and Directory Operations ==='
set d (begin
mktemp -d
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
cd "$d" || exit 1
printf '%s' 'a
' > a.sh
printf '%s' 'b
' > b.txt
mkdir sub
printf '%s' 'c
' > sub/c.sh
printf '%s' 'x
' > .hidden
set file_list (begin
ls -A | sort
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'File listing:'
printf '%s\n' "$file_list"
set found_files (begin
find . -name '*.sh' -type f
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'Found shell scripts:'
printf '%s\n' "$found_files"
cd /
rm -r -f "$d"
printf '%s\n' '=== File and Directory Operations Complete ==='
