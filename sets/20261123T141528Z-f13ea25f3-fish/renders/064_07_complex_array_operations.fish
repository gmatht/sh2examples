#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
:
set config_user admin; set config_len (math --scale 0 "$config_len + 1"); set -a config_keys user
set config_host localhost; set config_len (math --scale 0 "$config_len + 1"); set -a config_keys host
set config_port 8080; set config_len (math --scale 0 "$config_len + 1"); set -a config_keys port
begin
    set IFS '
'
    set sorted (string split " " -- $(printf '%s\n' (for _k in $config_keys
set -l _nk config_"$_k"
printf '%s\n' $$_nk
end) | sort
test $pipestatus[1] -eq 0))
end
printf '%s\n' "Config: $sorted"
