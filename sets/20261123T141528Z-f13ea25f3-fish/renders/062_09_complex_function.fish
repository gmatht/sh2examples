#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function complex_function
    set -l param1 "$argv[1]"
    set -l param2 (test -n "$argv[2]"; and printf '%s' "$argv[2]"; or printf '%s' "default")
    set -l param3 (string replace -a -r '\"' '\\\"' -- "$argv[3]")
    printf '%s\n' "Param1: $param1"
    printf '%s\n' "Param2: $param2"
    printf '%s\n' "Param3: $param3"
    set -l result $(printf '%s\n' "$param1" | sed s/old/new/g)
    printf '%s\n' "Result: $result"
end
complex_function 'test"quote' second_param 'third"param'
