#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function _num --argument val
    # bash coerces non-numeric arith values to 0; fish math errors
    if string match -qr -- '^-?[0-9]+$' $val
        echo $val
    else
        echo 0
    end
end

printf '%s\n' '=== Number Factorization Examples ==='
function factorize
    set -l n "$argv[1]"
    set -l divisor 2
    set -l factors ''
    printf '%s' "Factors of $n: "
    while [ "$n" -gt 1 ]
        while [ (math --scale 0 "($(_num $n) % $divisor)") -eq 0 ]
            if ! [ "$factors" != "" ]
                set factors "$divisor"
            else
                set factors "$factors"" * $divisor"
            end
            set n (math --scale 0 "($(_num $n) / $divisor)")
        end
        set divisor (math --scale 0 "($divisor + 1)")
        if [ (math --scale 0 "($divisor * $divisor)") -gt "$n" ]
            if [ "$n" -gt 1 ]
                if ! [ "$factors" != "" ]
                    set factors "$n"
                else
                    set factors "$factors"" * $n"
                end
            end
            break
        end
    end
    printf '%s\n' "$factors"
end
factorize 12
factorize 28
factorize 100
factorize 12345
printf '%s\n' 'Factorization complete!'
