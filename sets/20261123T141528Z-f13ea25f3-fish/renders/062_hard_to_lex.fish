#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
printf '%s\n' 'Testing ambiguous operators...'
set result (math --scale 0 "512")
printf '%s\n' "2**3**2 = $result"
printf '%s\n' 'Testing complex parameter expansions...'
set complex_var 'hello world'
echo (string match -rg -- '^.*?o(.*)$' "$complex_var"; or printf '%s' "$complex_var")
echo (string match -rg -- '^.*o(.*)$' "$complex_var"; or printf '%s' "$complex_var")
echo (string match -rg -- '^(.*)o.*$' "$complex_var"; or printf '%s' "$complex_var")
echo (string match -rg -- '^(.*?)o.*$' "$complex_var"; or printf '%s' "$complex_var")
printf '%s\n' 'Testing complex here-documents...'
printf '%s' 'This is a test line
This is not a test line
This is another test line
'
printf '%s\n' 'Testing nested arithmetic...'
set result (math --scale 0 "40")
printf '%s\n' "Complex arithmetic: $result"
printf '%s\n' 'Testing nested command substitution...'
printf '%s\n' (string join '' -- "Current dir: " (test -n "$PWD"; and printf '%s' "$PWD"; or printf '%s' $(pwd)))
printf '%s\n' (string join '' -- "User: " (test -n "$USER"; and printf '%s' "$USER"; or printf '%s' $(whoami)))
printf '%s\n' 'Testing process substitution...'
printf '%s\n' 'Testing complex brace expansion...'
printf '%s\n' 'a1x a1y a1z a2x a2y a2z a3x a3y a3z b1x b1y b1z b2x b2y b2z b3x b3y b3z c1x c1y c1z c2x c2y c2z c3x c3y c3z'
printf '%s\n' 'Testing simple case patterns...'
switch "$argv[1]"
    case 'test'
        echo 'Matched test'
    case '*'
        echo 'Default case'
end
function complex_function
    set -l param1 "$argv[1]"
    set -l param2 (test -n "$argv[2]"; and printf '%s' "$argv[2]"; or printf '%s' "default")
    set -l param3 (string replace -a -r '\"' '\\\"' -- "$argv[3]")
    printf '%s\n' "Param1: $param1"
    printf '%s\n' "Param2: $param2"
    printf '%s\n' "Param3: $param3"
    set -l result $(printf '%s\n' "$param1" | sed s/old/new/g)
    printf '%s\n' "Result: $result"
end
printf '%s\n' 'Testing simple pipeline...'
ls -l -a | grep ^d | head -5
printf '%s\n' 'Testing mixed arithmetic...'
set result (math --scale 0 "776")
printf '%s\n' "Mixed base result: $result"
printf '%s\n' 'Testing complex string interpolation...'
set message "Hello, "$(test -n "$USER"; and printf '%s' "$USER"; or printf '%s' $(whoami))"! Your home is "$(test -n "$HOME"; and printf '%s' "$HOME"; or printf '%s' $(echo ~))""
printf '%s\n' "$message"
printf '%s\n' 'Testing simple test expressions...'
if [ -f "file.txt" ]
    printf '%s\n' 'File exists'
else
    printf '%s\n' 'File does not exist'
end
printf '%s\n' 'Testing complex array operations...'
set array item1 item2 item3
set -a array item4
printf '%s\n' "Array: $array"
printf '%s\n' (string join '' -- "Length: " (count $array))
printf '%s\n' "First item: $array[1]"
function test_locals
    set -l var1 "$argv[1]"
    set -l var2 (test -n "$argv[2]"; and printf '%s' "$argv[2]"; or printf '%s' "default_value")
    set -l var3 (begin
printf '%s\n' "$var1" | tr '[:lower:]' '[:upper:]'
end)
    printf '%s\n' "Var1: $var1"
    printf '%s\n' "Var2: $var2"
    printf '%s\n' "Var3: $var3"
end
complex_function 'test"quote' second_param 'third"param'
test_locals hello world
