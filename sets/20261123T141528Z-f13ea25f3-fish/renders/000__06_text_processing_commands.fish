#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

printf '%s\n' '=== Text Processing Commands ==='
set file_content (begin
cat src/main.rs | head -5
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'First 5 lines of main.rs:'
printf '%s\n' "$file_content"
set grep_result (begin
grep -n fn src/main.rs
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'Lines containing \'fn\':'
printf '%s\n' "$grep_result"
set sed_result (begin
echo 'Hello World' | sed s/World/Universe/
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Sed result: $sed_result"
set awk_result (begin
echo '1 2 3 4 5' | awk '{print $1 + $2}'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Awk sum result: $awk_result"
set sort_result (begin
printf '%b\n' 'zebra\\napple\\nbanana' | sort
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'Sorted words:'
printf '%s\n' "$sort_result"
set uniq_result (begin
printf '%b\n' 'apple\\napple\\nbanana\\nbanana\\ncherry' | uniq
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'Unique words:'
printf '%s\n' "$uniq_result"
set word_count (begin
echo 'Hello World' | wc -w
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
set line_count (begin
printf '%b\n' 'line1\\nline2\\nline3' | wc -l
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Word count: $word_count"
printf '%s\n' "Line count: $line_count"
set head_result (begin
seq 1 10 | head -3
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "First 3 numbers: $head_result"
set tail_result (begin
seq 1 10 | tail -3
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Last 3 numbers: $tail_result"
set cut_result (begin
echo apple:banana:cherry | cut -d : -f 2
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Second field: $cut_result"
printf '%s' '1
2
3
' > temp1.txt
printf '%s' 'a
b
c
' > temp2.txt
set paste_result (begin
paste temp1.txt temp2.txt | sed 's/\\t/ /g'
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'Pasted columns:'
printf '%s\n' "$paste_result"
rm -f temp1.txt temp2.txt
printf '%s' 'apple
banana
cherry
' > file1.txt
printf '%s' 'banana
cherry
date
' > file2.txt
set comm_result (begin
comm -12 file1.txt file2.txt
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'Common lines:'
printf '%s\n' "$comm_result"
set diff_result (begin
diff file1.txt file2.txt
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'File differences:'
printf '%s\n' "$diff_result"
set tr_result (begin
echo 'HELLO WORLD' | tr A-Z a-z
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Lowercase: $tr_result"
set xargs_result (begin
echo '1 2 3' | xargs -n 1 echo Number:
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'Xargs result:'
printf '%s\n' "$xargs_result"
rm -f file1.txt file2.txt
