#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
# bash shell-identity variables fish does not set itself
set -g BASH_VERSION 5.2.15
set -g BASH_VERSINFO 5 2 15 1 release x86_64-pc-linux-gnu

if [ "$ZSH_VERSION" ]
    printf '%s\n' zsh
else if [ "$BASH_VERSION" ]
    printf '%s\n' bash
end
