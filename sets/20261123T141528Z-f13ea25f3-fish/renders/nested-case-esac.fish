#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
switch "$argv[1]"
    case 'start'
        echo Starting...
        switch "$argv[2]"
            case 'fast'
                echo 'Fast start'
            case 'slow'
                echo 'Slow start'
        end
    case 'stop'
        echo Stopping...
    case 'restart'
        echo Restarting...
        switch "$argv[2]"
            case 'soft'
                echo 'Soft restart'
            case 'hard'
                echo 'Hard restart'
        end
end
