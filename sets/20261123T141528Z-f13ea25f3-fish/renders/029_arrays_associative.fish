#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
set u
printf '%s\n' '== Associative arrays =='
:
set map_foo bar; set map_len (math --scale 0 "$map_len + 1"); set -a map_keys foo
set map_answer 42; set map_len (math --scale 0 "$map_len + 1"); set -a map_keys answer
set map_two '1 + 1'; set map_len (math --scale 0 "$map_len + 1"); set -a map_keys two
printf '%s\n' "$map_foo"
printf '%s\n' "$map_answer"
begin; for k in $map_keys; printf '%s\n' (string join '' -- $k " => " (set -l _nk map_"$k"; printf '%s\n' "$$_nk"))
end; end | sort
