#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
begin
    set __ps_tmp1 "$(mktemp)"
    begin; set __ps_tmp0 "$(mktemp)"
grep -v ^# /etc/passwd | cut -d : -f 1 >$__ps_tmp0
sort $__ps_tmp0
rm -f $__ps_tmp0; end >$__ps_tmp1
    set __ps_tmp3 "$(mktemp)"
    begin; set __ps_tmp2 "$(mktemp)"
grep -v ^# /etc/group | cut -d : -f 1 >$__ps_tmp2
sort $__ps_tmp2
rm -f $__ps_tmp2; end >$__ps_tmp3
    diff $__ps_tmp1 $__ps_tmp3
    set -l _ps_rc $status
    rm -f $__ps_tmp1 $__ps_tmp3
    test $_ps_rc -eq 0
end
printf '%s\n' "done: $status"
