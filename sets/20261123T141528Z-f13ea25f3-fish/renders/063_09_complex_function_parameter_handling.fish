#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function complex_function
    set args (string split " " -- $argv)
    set -e options
    set -l i 0
    while [ (math --scale 0 "$i") -lt (math --scale 0 "$(count $args)") ]
        switch "$(set -l _i (math --scale 0 "$i + 1"); printf '%s' $args[$_i])"
            case '--*'
                set -l key (string match -rg -- '^--(.*)$' "$(set -l _i (math --scale 0 "$i + 1"); printf '%s' $args[$_i])"; or printf '%s' "$(set -l _i (math --scale 0 "$i + 1"); printf '%s' $args[$_i])")
                set -l value (test -n "$(set -l _i (math --scale 0 "$i+1 + 1"); printf '%s' $args[$_i])"; and printf '%s' "$(set -l _i (math --scale 0 "$i+1 + 1"); printf '%s' $args[$_i])"; or printf '%s' "true")
                set -q options_len; or set options_len 0; set -l _wk options_"$key"; set $_wk "$value"; set options_len (math --scale 0 "$options_len + 1"); set -a options_keys options_"$key"
                begin
                    set i (math --scale 0 "$i + 2")
                end
            case '-*'
                set -l flags (string match -rg -- '^-(.*)$' "$(set -l _i (math --scale 0 "$i + 1"); printf '%s' $args[$_i])"; or printf '%s' "$(set -l _i (math --scale 0 "$i + 1"); printf '%s' $args[$_i])")
                set -l j 0
                while [ (math --scale 0 "$j") -lt (math --scale 0 "$(string length -- $flags)") ]
                    set -q options_len; or set options_len 0; set -l _wk options_flags:j:1; set $_wk true; set options_len (math --scale 0 "$options_len + 1"); set -a options_keys options_flags:j:1
                    begin
                        set -l j__sh2old $j; set j (math --scale 0 "$j + 1"); test $j__sh2old -ne 0
                    end
                end
                begin
                    set -l i__sh2old $i; set i (math --scale 0 "$i + 1"); test $i__sh2old -ne 0
                end
            case '*'
                break
        end
    end
    echo "Processed $options_len options"
end
echo (complex_function --flag1 '--option1=value1' -abc)
