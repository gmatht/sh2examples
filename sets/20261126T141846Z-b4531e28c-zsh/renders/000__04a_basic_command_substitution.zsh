#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- '=== Basic Command Substitution ==='
print -r -- "Current date: $(date +%Y)"
print -r -- "Current directory: $(basename $(pwd))"
current_date="$(date +%Y%m)"
current_dir="$(basename $(pwd))"
print -r -- "Stored date: $current_date"
print -r -- "Stored directory: $current_dir"
print -r -- '=== Basic Command Substitution Complete ==='
