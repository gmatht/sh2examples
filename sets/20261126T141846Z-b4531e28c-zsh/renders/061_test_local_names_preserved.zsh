#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
test_math() {
    local first_number="$1"
    local second_number="$2"
    local operation="$3"
    case "$operation" in
        "add")
            return $(((first_number + second_number)))
        ;;
        "subtract")
            return $(((first_number - second_number)))
        ;;
        "multiply")
            return $(((first_number * second_number)))
        ;;
        *)
            return "Unknown operation: $operation"
        ;;
    esac
}
test_strings() {
    local input_string="$1"
    local search_pattern="$2"
    local replacement="$3"
    case "$search_pattern" in
        "start")
            return "Replacing start of: $input_string with: $replacement"
        ;;
        "end")
            return "Replacing end of: $input_string with: $replacement"
        ;;
        "middle")
            return "Replacing middle of: $input_string with: $replacement"
        ;;
        *)
            return "Unknown pattern: $search_pattern for string: $input_string"
        ;;
    esac
}
test_arrays() {
    local array_name="$1"
    local index="$2"
    local new_value="$3"
    case "$index" in
        "first")
            return "Setting first element of $array_name to $new_value"
        ;;
        "last")
            return "Setting last element of $array_name to $new_value"
        ;;
        *)
            return "Setting element $index of $array_name to $new_value"
        ;;
    esac
}
echo $(test_math 10 5 add)
echo $(test_math 10 5 multiply)
echo $(test_strings 'hello world' start hi)
echo $(test_strings 'hello world' end bye)
echo $(test_arrays my_array first new_value)
echo $(test_arrays my_array last final_value)
