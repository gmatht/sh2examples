#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -- 'match1\nmatch2\nmatch3\nmatch4' | grep -m 2 match
echo 'text with pattern in it' | grep -b pattern
printf '%s' 'content
' > temp_file.txt
grep -h content temp_file.txt
grep -H content temp_file.txt
grep -Z -l pattern temp_file.txt | tr '\0' '\n'
echo 'text with pattern in it' | grep '--color=always' pattern || echo 'Color not supported'
grep -q pattern temp_file.txt && echo found || echo 'not found'
rm temp_file.txt
matched="$(printf '%s\n' test | grep -c '.*')"
print -r -- "  grep_exit: $?"
print -r -- "  match_count: $matched"
