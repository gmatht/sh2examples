#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
echo 'foo123 bar456' | grep -E '(foo|bar)[0-9]+'
echo 'a+b*c?' | grep -F 'a+b*c?'
echo 'word wordly subword' | grep -w word
print -- 'exact whole line\npartial line' | grep -x 'exact whole line'
print -- 'error message\nwarning message\ninfo message' | grep -E 'error|warning'
{
    __ps_tmp0="$(mktemp)"
    printf '%s' 'error
warning
' > $__ps_tmp0
    print -- 'error\nwarning' | grep -f $__ps_tmp0
    rm -f $__ps_tmp0
}
echo 'file123.txt backup456.bak' | grep -E '([a-z]+)([0-9]+)\.([a-z]+)'
matched="$(printf '%s\n' test | grep -c '.*')"
print -r -- "  grep_exit: $?"
print -r -- "  match_count: $matched"
