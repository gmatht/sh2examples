#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS

setopt shwordsplit globsubst
set -u
capture() {
    local label="$1"
    shift
    {
        local tmp_stdout
        local tmp_stderr
    }
    tmp_stdout="$(mktemp /tmp/tty_demo_stdout_XXXXXX)"
    tmp_stderr="$(mktemp /tmp/tty_demo_stderr_XXXXXX)"
    "$@" >"$tmp_stdout" 2>"$tmp_stderr"
    local ec=${=?}
    local so
    so="$(cat "$tmp_stdout")"
    local se
    se="$(cat "$tmp_stderr")"
    rm -f "$tmp_stdout" "$tmp_stderr"
    print -r -- "--- ["$label"] ---"
    echo "  cmd     : $*"
    print -r -- "  exitcode: "$ec""
    if [ "$so" != "" ]; then
        print -r -- "  stdout  : "$so""
    else
        print -r -- '  stdout  : (empty)'
    fi
    if [ "$se" != "" ]; then
        print -r -- "  stderr  : "$se""
    fi
    print -r -- ''
    return "$ec"
}
TTY_DEV=''
for dev in /dev/pts/2 /dev/pts/3 /dev/pts/4; do
    if [ -r "$dev" ]; then
        TTY_DEV="$dev"
        break
    fi
done
if ! [ "$TTY_DEV" != "" ]; then
    for dev in /dev/pts/*; do
        if [ -r "$dev" ]; then
            TTY_DEV="$dev"
            break
        fi
    done
fi
print -r -- "Using terminal device: ${TTY_DEV:-NONE}"
print -r -- ''
print -r -- '============================================================'
print -r -- ' SECTION 1: tty (default) — with a real terminal'
print -r -- '============================================================'
if [ "$TTY_DEV" != "" ]; then
    capture 01-default-terminal tty <"$TTY_DEV"
else
    print -r -- '  (skipped — no terminal device available)'
    print -r -- ''
fi
print -r -- '============================================================'
print -r -- ' SECTION 2: tty (default) — stdin from /dev/null'
print -r -- '============================================================'
capture 02-not-a-tty tty </dev/null
print -r -- '============================================================'
print -r -- ' SECTION 3: tty (default) — piped input'
print -r -- '============================================================'
capture 03-pipe-notty bash -c 'echo "dummy" | tty'
print -r -- '============================================================'
print -r -- ' SECTION 4: tty -s — with a real terminal (silent)'
print -r -- '============================================================'
if [ "$TTY_DEV" != "" ]; then
    capture 04-silent-terminal tty -s <"$TTY_DEV"
else
    print -r -- '  (skipped — no terminal device available)'
    print -r -- ''
fi
print -r -- '============================================================'
print -r -- ' SECTION 5: tty -s — stdin from /dev/null (silent, not a tty)'
print -r -- '============================================================'
capture 05-silent-notty tty -s </dev/null
print -r -- '============================================================'
print -r -- ' SECTION 6: tty -s — piped input (silent, not a tty)'
print -r -- '============================================================'
capture 06-silent-pipe bash -c 'echo "dummy" | tty -s'
print -r -- '============================================================'
print -r -- ' SECTION 7: tty --silent — long form, with a real terminal'
print -r -- '============================================================'
if [ "$TTY_DEV" != "" ]; then
    capture 07-long-silent tty --silent <"$TTY_DEV"
else
    print -r -- '  (skipped — no terminal device available)'
    print -r -- ''
fi
print -r -- '============================================================'
print -r -- ' SECTION 8: tty --quiet — long form, with a real terminal'
print -r -- '============================================================'
if [ "$TTY_DEV" != "" ]; then
    capture 08-long-quiet tty --quiet <"$TTY_DEV"
else
    print -r -- '  (skipped — no terminal device available)'
    print -r -- ''
fi
print -r -- '============================================================'
print -r -- ' SECTION 9: tty --silent — stdin from /dev/null (not a tty)'
print -r -- '============================================================'
capture 09-long-silent-notty tty --silent </dev/null
print -r -- '============================================================'
print -r -- ' SECTION 10: tty --quiet — stdin from /dev/null (not a tty)'
print -r -- '============================================================'
capture 10-long-quiet-notty tty --quiet </dev/null
print -r -- '============================================================'
print -r -- ' SECTION 11: tty (default) — inheriting stdin from the script'
print -r -- '============================================================'
capture 11-inherited tty
print -r -- '============================================================'
print -r -- ' SECTION 12: tty -s — inheriting stdin from the script'
print -r -- '============================================================'
capture 12-inherited-silent tty -s
print -r -- '============================================================'
print -r -- ' SECTION 13: tty -s -s — repeated silent flag'
print -r -- '============================================================'
if [ "$TTY_DEV" != "" ]; then
    capture 13-double-silent tty -s -s <"$TTY_DEV"
else
    print -r -- '  (skipped — no terminal device available)'
    print -r -- ''
fi
print -r -- ''
print -r -- 'All tty demo sections completed.'
