#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- '== Basic grep parameters =='
echo 'text with pattern' | grep -i PATTERN && echo '  -i match: OK' || echo '  -i match: FAIL'
count="$(print -- 'line1\nline2\nline3' | grep -v line2 | wc -l)"
print -r -- "  -v count: $count (expected 2)"
matched="$(print -- 'match\nno match\nmatch again' | grep -c match)"
print -r -- "  -c count: $matched (expected 2)"
print -r -- '== Context parameters =='
print -- 'line1\nline2\nTARGET\nline4\nline5' | grep -A 2 TARGET >/tmp/grep_out.txt
print -r -- "  -A 2 lines: $(wc -l </tmp/grep_out.txt) (expected 3)"
print -- 'line1\nline2\nTARGET\nline4\nline5' | grep -B 2 TARGET >/tmp/grep_out.txt
print -r -- "  -B 2 lines: $(wc -l </tmp/grep_out.txt) (expected 3)"
print -- 'line1\nline2\nTARGET\nline4\nline5' | grep -C 1 TARGET >/tmp/grep_out.txt
print -r -- "  -C 1 lines: $(wc -l </tmp/grep_out.txt) (expected 3)"
print -r -- '== File handling parameters =='
printf '%s' 'content
' > /tmp/grep_file.txt
grep -c content /tmp/grep_file.txt && echo '  -c file: OK' || echo '  -c file: FAIL'
grep -l content /tmp/grep_file.txt && echo '  -l: found' || echo '  -l: not found'
grep -L nonexistent /tmp/grep_file.txt && echo '  -L: not found (correct)' || echo '  -L: found (wrong)'
print -r -- '== Output formatting parameters =='
matched="$($(printf '%s
' 'text with pattern in it' | grep -o pattern))"
print -r -- "  -o match: '$matched' (expected 'pattern')"
lineno="$(echo 'text with pattern in it' | grep -n pattern | cut -d : -f 1)"
print -r -- "  -n line: $lineno (expected 1)"
print -r -- '== Recursive parameters =='
mkdir -p /tmp/grep_sub && echo 'subfile content' >/tmp/grep_sub/file.txt
found="$(grep -r subfile /tmp/grep_sub 2>/dev/null | wc -l)"
print -r -- "  -r recursive: $found files matched (expected 1)"
rm -r -f /tmp/grep_sub
print -r -- '== Line length parameters =='
longline="$(printf '%s' aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)"
print -r -- "$longline" | grep -m 1 a >/dev/null && echo '  -m 1 (long line): OK' || echo '  -m 1 (long line): FAIL'
print -r -- '== Word-regexp and line-regexp parameters =='
print -- 'foo\nfoobar\nbar' | grep -w foo >/tmp/grep_out.txt
print -r -- "  -w word match lines: $(wc -l </tmp/grep_out.txt) (expected 1)"
rm -f /tmp/grep_file.txt /tmp/grep_out.txt
