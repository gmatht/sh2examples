#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
set -e -u
print -r -- '== Basic brace expansion =='
print -r -- '1 2 3 4 5'
print -r -- 'a b c'
print -r -- '00 02 04'
print -r -- '== Advanced brace expansion =='
print -r -- 'a1 a2 a3 b1 b2 b3 c1 c2 c3'
print -r -- '1 3 5 7 9'
print -r -- 'a d g j m p s v y'
print -r -- '== Practical examples =='
touch file_001.txt file_002.txt file_003.txt file_004.txt file_005.txt
ls file_*.txt | sort
rm file_*.txt
print -r -- "brace_expand: 1 2 3 4 5"
