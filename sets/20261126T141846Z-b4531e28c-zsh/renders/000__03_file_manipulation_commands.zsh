#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- '=== File Manipulation Commands ==='
print -r -- '=== cp command ==='
d="$(mktemp -d)"
cd "$d" || exit 1
print -r -- ''
printf '%s' 'test content
' > test_file.txt
cp_result="$(cp test_file.txt test_file_copy.txt && echo 'Copy successful')"
print -r -- "Copy result: $cp_result"
ls test_file.txt test_file_copy.txt test_file_moved.txt | sort 2>/dev/null || echo 'No test files found'
print -r -- ''
print -r -- '=== mv command ==='
mv_result="$(mv test_file_copy.txt test_file_moved.txt && echo 'Move successful')"
print -r -- "Move result: $mv_result"
ls test_file.txt test_file_copy.txt test_file_moved.txt | sort 2>/dev/null || echo 'No test files found'
print -r -- ''
print -r -- '=== rm command ==='
rm_result="$(rm test_file.txt test_file_moved.txt && echo 'Remove successful')"
print -r -- "Remove result: $rm_result"
ls test_file.txt test_file_copy.txt test_file_moved.txt | sort 2>/dev/null || echo 'No test files found'
print -r -- ''
print -r -- '=== mkdir command ==='
mkdir_result="$(mkdir test_dir && echo 'Directory created')"
print -r -- "Mkdir result: $mkdir_result"
touch test_dir/file
ls test_dir | sort 2>/dev/null || echo 'Directory not found'
rm test_dir/file
rmdir test_dir
print -r -- ''
print -r -- '=== touch command ==='
touch_result="$(touch test_file.txt && echo 'File touched')"
print -r -- "Touch result: $touch_result"
print -r -- ''
rm -f test_file.txt test_file_copy.txt test_file_moved.txt
rm -r -f test_dir 2>/dev/null || true
cd /
rm -r -f "$d"
