#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
result=$((((((((a + b) * (c - d)) / (e % f)) + (g ** h)) - (i << j)) | ((k & l) ^ (m | n)))))
typeset -A matrix
matrix[0,0]=$((((x + y) * z)))
matrix[1,1]="${array[${${index}:-0}]}"
matrix[2,2]=${(k)prefix[@]}
matrix[3,3]=${#array[@]}
output="$(print -r -- "Result: $(print -r -- "Nested: $(print -r -- "Deep: $(echo 'Level 4')")")")"
print -r -- "${var:-${default:-${fallback:-computed}}}"
print -r -- "${array[${index}]:-${default[@]:0:2}}"
print -r -- "${(k)prefix*[@]}"
cat <<'EOF' | grep -v ^# | sed 's/^/  /'
# This is a comment
$(echo "Command substitution")
${var:-default}
$(( 1 + 2 * 3 ))
EOF

(
    (
        sleep 1
        echo Starting
    )
) &
(
    (
        sleep 2
        echo Processing
    )
) &
wait
print -r -- 'All done'
if printf '%s\n' "$var" | grep -Eq '^[0-9]+$' && [ "$((var > 0))" -ne 0 ] && [ -f "$file" ]; then
    if printf '%s\n' "${array[@]}" | grep -Eq '"value"' || [ "$((${#array[@]} > 5))" -ne 0 ]; then
        if [ "$(echo "$var" | grep -q "pattern")" ]; then
            print -r -- 'Deeply nested condition met'
        fi
    fi
fi
case "$(print -r -- "$var" | tr '[:upper:]' '[:lower:]')" in
    *[0-9]*)
        case "$(printf '%s' "$var" | tr A-Z a-z)" in
            *pattern*)
                echo 'Double nested pattern'
            ;;
            *)
                echo 'Single nested pattern'
            ;;
        esac
    ;;
    *)
        echo 'No numbers'
    ;;
esac
complex_function() {
    local args=("$@")
    local options=()
    local i=0
    while [ "$((i < ${#args[@]}))" -ne 0 ]; do
        case "${args[i]}" in
            --*)
                local key="${args[i]#--}"
                local value="${args[i+1]:-true}"
                options[$key]="$value"
                {
                    i=$((i += 2))
                }
            ;;
            -*)
                local flags="${args[i]#-}"
                local j=0
                while [ "$((j < ${#flags}))" -ne 0 ]; do
                    options[${flags:j:1}]=true
                    {
                        ((((j = j + 1) - 1)))
                    }
                done
                {
                    ((((i = i + 1) - 1)))
                }
            ;;
            *)
                break
            ;;
        esac
    done
    printf '%s\n' "Processed ${#options[@]} options"
}
{
    i=$((i = 0))
    while [ "$((i<${#array[@]}))" -ne 0 ]; do
        {
            j=$((j = 0))
            while [ "$((j<${#array[i][@]}))" -ne 0 ]; do
                if [ "$((array[i][j] > threshold))" -ne 0 ]; then
                    result[i]=$(( result[i] + array[i][j] ))
                fi
                ((((j = j + 1) - 1)))
            done
        }
        ((((i = i + 1) - 1)))
    done
}
{
    __ps_tmp0="$(mktemp)"
    grep -v ^# "$input_file" | head -n "$max_lines" >$__ps_tmp0
    while { IFS='' true; read -r line && [ -n "$line" ] && [ "$((counter < max_lines))" -ne 0 ]; }; do if printf '%s\n' ""$line"" | grep -Eq '^[[:space:]]*#'; then continue; fi; case "$line" in *\$\(*\)*) print -r -- "Contains command substitution: $line";; *\$\{[^}]*\}*) print -r -- "Contains parameter expansion: $line";; *\$\(\(*\)\)*) print -r -- "Contains arithmetic expansion: $line";; esac; { ((((counter = counter + 1) - 1))); }; done <$__ps_tmp0
    rm -f $__ps_tmp0
}
eval 'result=$(( ${var:-0} + ${array[${index:-0}]:-0} ))'
( ( ( echo 'Level 3'; ( echo 'Level 4'; echo 'Still level 4' ) ) | grep Level ) | sed s/Level/Depth/ ) | wc -l
{
    __ps_tmp1="$(mktemp)"
    sort file1.txt >$__ps_tmp1
    __ps_tmp2="$(mktemp)"
    sort file2.txt >$__ps_tmp2
    diff $__ps_tmp1 $__ps_tmp2 >comparison.txt 2>&1
    rm -f $__ps_tmp1 $__ps_tmp2
}
if [ -n "$var" -a -f "$file" -o -d "$dir" ] && [ "$(wc -l < "$file")" -gt 10 ]; then
    print -r -- 'Complex test passed'
fi
print -r -- 'a1x a1y a1z a2x a2y a2z a3x a3y a3z b1x b1y b1z b2x b2y b2z b3x b3y b3z c1x c1y c1z c2x c2y c2z c3x c3y c3z'
printf '%s\n' "$(print -r -- "UPPER: $(printf '%s' "$var" | tr a-z A-Z)")" | tr '[:upper:]' '[:lower:]'
echo $(complex_function '--long-option=value with spaces' --array-option item1 item2 item3 --flag 'positional argument' "${var:-default}" computed)
( { __sh2_tc0="$(print -r -- "$var" | tr '[:upper:]' '[:lower:]')"; if printf '%s\n' ""${__sh2_tc0}"" | grep -Eq '^[a-z]+$'; then { i=$((i = 0)); while [ "$((i<${#array[@]}))" -ne 0 ]; do if [ "$((array[i] > threshold))" -ne 0 ] && [ -f "${files[i]}" ]; then result[i]=$(false); fi; ((((i = i + 1) - 1))); done; }; fi; } ) | sort -n | tail -n 5 >final_result.txt
