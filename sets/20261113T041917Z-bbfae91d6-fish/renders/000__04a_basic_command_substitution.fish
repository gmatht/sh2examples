#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

echo '=== Basic Command Substitution ==='
printf '%s\n' (string join '' -- "Current date: " (date +%Y))
printf '%s\n' (string join '' -- "Current directory: " (basename $(pwd)))
set current_date (date +%Y%m | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
set current_dir (basename $(pwd) | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Stored date: $current_date"
printf '%s\n' "Stored directory: $current_dir"
echo '=== Basic Command Substitution Complete ==='
