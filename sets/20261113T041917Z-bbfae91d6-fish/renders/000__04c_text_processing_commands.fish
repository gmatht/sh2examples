#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

echo '=== Text Processing Commands ==='
set file_content (cat 000__04c_text_processing_commands.sh | head -5 | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
echo 'First 5 lines of this file:'
printf '%s\n' "$file_content"
set grep_result (grep -n echo 000__04c_text_processing_commands.sh | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' 'Lines containing \'echo\':'
printf '%s\n' "$grep_result"
set sed_result (echo 'Hello World' | sed s/World/Universe/ | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Sed result: $sed_result"
set awk_result (echo '1 2 3 4 5' | awk '{print $1 + $2}' | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Awk sum result: $awk_result"
set sort_result (printf '%b\n' 'zebra\\napple\\nbanana' | sort | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
echo 'Sorted words:'
printf '%s\n' "$sort_result"
set uniq_result (printf '%b\n' 'apple\\napple\\nbanana\\nbanana\\ncherry' | uniq | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
echo 'Unique words:'
printf '%s\n' "$uniq_result"
set word_count (echo 'Hello World' | wc -w | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
set line_count (printf '%b\n' 'line1\\nline2\\nline3' | wc -l | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Word count: $word_count"
printf '%s\n' "Line count: $line_count"
set head_result (seq 1 10 | head -3 | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "First 3 numbers: $head_result"
set tail_result (seq 1 10 | tail -3 | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Last 3 numbers: $tail_result"
set cut_result (echo apple:banana:cherry | cut -d : -f 2 | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Second field: $cut_result"
printf '%b\n' '1\\n2\\n3' >temp1.txt
printf '%b\n' 'a\\nb\\nc' >temp2.txt
set paste_result (paste temp1.txt temp2.txt | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
echo 'Pasted columns:'
printf '%s\n' "$paste_result"
rm -f temp1.txt temp2.txt
printf '%b\n' 'apple\\nbanana\\ncherry' >file1.txt
printf '%b\n' 'banana\\ncherry\\ndate' >file2.txt
set comm_result (comm -12 file1.txt file2.txt | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
echo 'Common lines:'
printf '%s\n' "$comm_result"
set diff_result (diff file1.txt file2.txt | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
echo 'File differences:'
printf '%s\n' "$diff_result"
set d (mktemp -d | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
cd "$d" || exit 1
set tr_result (echo 'HELLO WORLD' | tr A-Z a-z | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Lowercase: $tr_result"
set xargs_result (echo '1 2 3' | xargs -n 1 echo Number: | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
echo 'Xargs result:'
printf '%s\n' "$xargs_result"
rm -f file1.txt file2.txt
cd /
rm -r -f "$d"
echo '=== Text Processing Commands Complete ==='
