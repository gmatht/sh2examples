#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

echo '=== File Manipulation Commands ==='
echo '=== cp command ==='
set d (mktemp -d | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
cd "$d" || exit 1
echo
echo 'test content' >test_file.txt
set cp_result (begin; cp test_file.txt test_file_copy.txt && echo 'Copy successful'; end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Copy result: $cp_result"
ls test_file.txt test_file_copy.txt test_file_moved.txt 2>/dev/null | sort; test $pipestatus[1] -eq 0 || echo 'No test files found'
echo
echo '=== mv command ==='
set mv_result (begin; mv test_file_copy.txt test_file_moved.txt && echo 'Move successful'; end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Move result: $mv_result"
ls test_file.txt test_file_copy.txt test_file_moved.txt 2>/dev/null | sort; test $pipestatus[1] -eq 0 || echo 'No test files found'
echo
echo '=== rm command ==='
set rm_result (begin; rm test_file.txt test_file_moved.txt && echo 'Remove successful'; end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Remove result: $rm_result"
ls test_file.txt test_file_copy.txt test_file_moved.txt 2>/dev/null | sort; test $pipestatus[1] -eq 0 || echo 'No test files found'
echo
echo '=== mkdir command ==='
set mkdir_result (begin; mkdir test_dir && echo 'Directory created'; end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Mkdir result: $mkdir_result"
touch test_dir/file
ls test_dir 2>/dev/null | sort; test $pipestatus[1] -eq 0 || echo 'Directory not found'
rm test_dir/file
rmdir test_dir
echo
echo '=== touch command ==='
set touch_result (begin; touch test_file.txt && echo 'File touched'; end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Touch result: $touch_result"
echo
rm -f test_file.txt test_file_copy.txt test_file_moved.txt
rm -r -f test_dir 2>/dev/null || true
cd /
rm -r -f "$d"
