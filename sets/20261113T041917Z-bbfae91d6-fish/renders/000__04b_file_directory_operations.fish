#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

echo '=== File and Directory Operations ==='
set d (mktemp -d | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
cd "$d" || exit 1
printf 'a\\n' >a.sh
printf 'b\\n' >b.txt
mkdir sub
printf 'c\\n' >sub/c.sh
printf 'x\\n' >.hidden
set file_list (ls -A | sort | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
echo 'File listing:'
printf '%s\n' "$file_list"
set found_files (find . -name '*.sh' -type f | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
echo 'Found shell scripts:'
printf '%s\n' "$found_files"
cd /
rm -r -f "$d"
echo '=== File and Directory Operations Complete ==='
