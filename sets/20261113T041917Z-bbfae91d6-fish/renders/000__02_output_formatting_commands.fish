#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

echo '=== Output and Formatting Commands ==='
printf '%s\n' "Echo result: Hello from backticks"
printf '%s\n' "Printf result: Number: 42, String: test"
echo '=== Compression Commands ==='
echo '=== Network Commands ==='
echo '=== Process Management Commands ==='
set d (mktemp -d | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
cd "$d" || exit 1
echo '=== Checksum Commands ==='
echo 'test content' >test_checksum.txt
set sha256_result (sha256sum test_checksum.txt | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "SHA256 result: $sha256_result"
set sha512_result (sha512sum test_checksum.txt | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "SHA512 result: $sha512_result"
set strings_result (strings test_binary.txt | head -3 | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
echo 'Strings result:'
printf '%s\n' "$strings_result"
echo '=== I/O Redirection Commands ==='
set tee_result (echo 'test output' | tee test_tee.txt | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Tee result: $tee_result"
echo '=== Perl Command ==='
set perl_result (perl -e 'print "Hello from Perl\\n"' | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
printf '%s\n' "Perl result: $perl_result"
rm -f test_checksum.txt test_tee.txt
cd /
rm -r -f "$d"
