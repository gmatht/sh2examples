+            let mut depth = 0usize;
+            let mut k = j;
+            let mut close = None;
+            while k < n {
+                if in_lit[k] {
+                    k += 1;
+                    continue;
+                }
+                if b[k] == b'(' {
+                    depth += 1;
+                } else if b[k] == b')' {
+                    depth -= 1;
+                    if depth == 0 {
+                        close = Some(k);
+                        break;
+                    }
+                }
+                k += 1;
+            }
+            let Some(close) = close else {
+                i = j;
+                continue;
+            };
+            let mut d = 0i32;
+            let mut p = j + 1;
+            while p < close {
+                let c = b[p];
+                if c == b'"' {
+                    let mut e = p + 1;
+                    while e < close {
+                        if b[e] == b'\\' {
+                            e += 2;
+                            continue;
+                        }
+                        if b[e] == b'"' {
+                            e += 1;
+                            break;
+                        }
+                        e += 1;
+                    }
+                    let borrowed = p > 0 && b[p - 1] == b'&';
+                    if d == 0 && !borrowed && e <= n && b[e.min(n)..].starts_with(SUF.as_bytes())
+                    {
+                        let after = e + SUF.len();
+                        let mut q = after;
+                        while q < n && (b[q] == b' ' || b[q] == b'\t') {
+                            q += 1;
+                        }
+                        if q == close || b[q] == b',' || b[q] == b')' {
+                            cut.push((e, after));
+                            p = after;
+                            continue;
+                        }
+                    }
+                    p = e;
+                    continue;
+                }
+                match c {
+                    b'(' | b'[' | b'{' => d += 1,
+                    b')' | b']' | b'}' => d -= 1,
+                    _ => {}
+                }
+                p += 1;
+            }
+            i = close + 1;
+            continue;
+        }
+        let mut j = i + name_len + 1;
+        while j < n && (b[j] == b' ' || b[j] == b'\t') {
+            j += 1;
+        }
+        if j >= n || b[j] != b'(' {
+            i += 1;
+            continue;
+        }
+        // matching `)`, skipping literal content
+        let mut depth = 0usize;
+        let mut k = j;
+        let mut close = None;
+        while k < n {
+            if in_lit[k] {
+                k += 1;
+                continue;
+            }
+            if b[k] == b'(' {
+                depth += 1;
+            } else if b[k] == b')' {
+                depth -= 1;
+                if depth == 0 {
+                    close = Some(k);
+                    break;
+                }
+            }
+            k += 1;
+        }
+        let Some(close) = close else {
+            i = j;
+            continue;
+        };
+        // the macro's OWN arguments: depth 0 within its parens
+        let mut d = 0i32;
+        let mut p = j + 1;
+        while p < close {
+            let c = b[p];
+            if c == b'"' {
+                let mut e = p + 1;
+                while e < close {
+                    if b[e] == b'\\' {
+                        e += 2;
+                        continue;
+                    }
+                    if b[e] == b'"' {
+                        e += 1;
+                        break;
+                    }
+                    e += 1;
+                }
+                let borrowed = p > 0 && b[p - 1] == b'&';
+                if d == 0 && !borrowed && e <= n && b[e.min(n)..].starts_with(SUF.as_bytes()) {
+                    let after = e + SUF.len();
+                    let mut q = after;
+                    while q < n && (b[q] == b' ' || b[q] == b'\t') {
+                        q += 1;
+                    }
+                    if q == close || b[q] == b',' || b[q] == b')' {
+                        cut.push((e, after));
+                        p = after;
+                        continue;
+                    }
+                }
+                p = e;
+                continue;
+            }
+            match c {
+                b'(' | b'[' | b'{' => d += 1,
+                b')' | b']' | b'}' => d -= 1,
+                _ => {}
+            }
+            p += 1;
+        }
+        i = close + 1;
+    }
+    if cut.is_empty() {
+        return text;
+    }
+    let mut out = String::with_capacity(text.len());
+    let mut last = 0;
+    for (s, e) in cut {
+        out.push_str(&text[last..s]);
+        last = e;
+    }
+    out.push_str(&text[last..]);
+    out
+}
