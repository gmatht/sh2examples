#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS

setopt shwordsplit globsubst
y=y+=2
z+=(a b)
z=z+="$(printf '%s' "$primes[@]" | cut -c1-1)"
print -r -- '=== Prime Number Generator (first 1000 primes) ==='
is_prime() {
    local n="$1"
    if [ $(( n )) -lt $(( 2 )) ]; then
        return 1
    fi
    if [ $(( n )) -eq $(( 2 )) ]; then
        return 0
    fi
    if [ $(( (n % 2) )) -eq $(( 0 )) ]; then
        return 1
    fi
    local sqrt_n=$(print -r -- "sqrt($n)" | bc)
    local i=3
    while [ $(( i )) -le $(( sqrt_n )) ]; do
        if [ "$((n % i))" -eq 0 ]; then
            return 1
        fi
        i=$(((i + 2)))
    done
    return 0
}
print -r -- 'Finding first 100 prime numbers...'
print -r -- 'This may take a while...'
primes=(2)
count=1
candidate=3
while [ $(( count )) -lt $(( 100 )) ]; do
    if is_prime ${=candidate}; then
        primes+=(${=candidate})
        count=$(((count + 1)))
        if [ $(( (count % 10) )) -eq $(( 0 )) ]; then
            print -r -- "Found $count primes so far..."
        fi
    fi
    candidate=$(((candidate + 2)))
done
print -r -- ''
print -r -- 'First 1000 prime numbers found!'
print -r -- "Count: ${#primes[@]}"
print -r -- "First 10: ${primes[@]:0:10}"
print -r -- "Last 10: ${primes[@]: -10}"
print -r -- 'Prime number generation complete!'
