#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- '=== Text Processing Commands ==='
file_content="$(cat src/main.rs | head -5)"
print -r -- 'First 5 lines of main.rs:'
print -r -- "$file_content"
grep_result="$(grep -n fn src/main.rs)"
print -r -- 'Lines containing '\''fn'\'':'
print -r -- "$grep_result"
sed_result="$(echo 'Hello World' | sed s/World/Universe/)"
print -r -- "Sed result: $sed_result"
awk_result="$(echo '1 2 3 4 5' | awk '{print $1 + $2}')"
print -r -- "Awk sum result: $awk_result"
sort_result="$(print -- 'zebra\napple\nbanana' | sort)"
print -r -- 'Sorted words:'
print -r -- "$sort_result"
uniq_result="$(print -- 'apple\napple\nbanana\nbanana\ncherry' | uniq)"
print -r -- 'Unique words:'
print -r -- "$uniq_result"
word_count="$(echo 'Hello World' | wc -w)"
line_count="$(print -- 'line1\nline2\nline3' | wc -l)"
print -r -- "Word count: $word_count"
print -r -- "Line count: $line_count"
head_result="$(seq 1 10 | head -3)"
print -r -- "First 3 numbers: $head_result"
tail_result="$(seq 1 10 | tail -3)"
print -r -- "Last 3 numbers: $tail_result"
cut_result="$(echo apple:banana:cherry | cut -d : -f 2)"
print -r -- "Second field: $cut_result"
printf '%s' '1
2
3
' > temp1.txt
printf '%s' 'a
b
c
' > temp2.txt
paste_result="$(paste temp1.txt temp2.txt | sed 's/\t/ /g')"
print -r -- 'Pasted columns:'
print -r -- "$paste_result"
rm -f temp1.txt temp2.txt
printf '%s' 'apple
banana
cherry
' > file1.txt
printf '%s' 'banana
cherry
date
' > file2.txt
comm_result="$(comm -12 file1.txt file2.txt)"
print -r -- 'Common lines:'
print -r -- "$comm_result"
diff_result="$(diff file1.txt file2.txt)"
print -r -- 'File differences:'
print -r -- "$diff_result"
tr_result="$(echo 'HELLO WORLD' | tr A-Z a-z)"
print -r -- "Lowercase: $tr_result"
xargs_result="$(echo '1 2 3' | xargs -n 1 echo Number:)"
print -r -- 'Xargs result:'
print -r -- "$xargs_result"
rm -f file1.txt file2.txt
