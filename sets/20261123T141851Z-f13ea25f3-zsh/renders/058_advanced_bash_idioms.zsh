#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- '=== Advanced Bash Idioms Examples ==='
print -r -- ''
print -r -- '1. Nested loops with conditional logic and array manipulation:'
numbers=(1 2 3 4 5)
letters=(a b c d e)
for num in ${numbers[@]}; do
    for letter in ${letters[@]}; do
        if [ $(( num )) -gt $(( 3 )) ] && [ "$letter" != "c" ]; then
            print -r -- "  Number $num with letter $letter (filtered)"
        fi
    done
done
print -r -- ''
print -r -- '2. Function with nested case statements and parameter expansion:'
process_data() {
    local data_type="$1"
    local value="$2"
    case "$data_type" in
        "string")
            case "$(printf '%s' "$value" | tr A-Z a-z)" in
                "hello" | "hi")
                    return "  Greeting detected: $value"
                ;;
                "bye" | "goodbye")
                    return "  Farewell detected: $value"
                ;;
                *)
                    return "  Unknown string: $value"
                ;;
            esac
        ;;
        "number")
            if printf '%s\n' ""$value"" | grep -Eq '^[0-9]+$'; then
                if [ "$((value % 2 == 0))" -ne 0 ]; then
                    return "  Even number: $value"
                else
                    return "  Odd number: $value"
                fi
            else
                return "  Invalid number: $value"
            fi
        ;;
        *)
            return "  Unknown data type: $data_type"
        ;;
    esac
}
echo $(process_data string Hello)
echo $(process_data string Bye)
echo $(process_data number 42)
echo $(process_data number 17)
print -r -- ''
print -r -- '3. Complex conditional with command substitution and arithmetic:'
file_count="$(find . -maxdepth 1 -type f | wc -l)"
dir_count="$(find . -maxdepth 1 -type d | wc -l)"
if [ $(( file_count )) -gt $(( 0 )) ] && [ $(( dir_count )) -gt $(( 1 )) ]; then
    if [ "$((file_count > dir_count))" -ne 0 ]; then
        print -r -- "  More files ($file_count) than directories ($dir_count)"
    else
        if [ "$((file_count == dir_count))" -ne 0 ]; then
            print -r -- "  Equal count: $file_count files and $dir_count directories"
        else
            print -r -- "  More directories ($dir_count) than files ($file_count)"
        fi
    fi
else
    print -r -- '  Insufficient items for comparison'
fi
print -r -- ''
print -r -- '4. Nested here-documents with parameter expansion:'
user=admin
host=localhost
port=22
print -rn -- '    SSH Configuration:
    $(cat <<'\''INNER'\''
        User: $user
        Host: $host
        Port: $port
        Status: $(ping -c 1 $host >/dev/null 2>&1 && echo "Online" || echo "Offline")
INNER
    )
'
print -r -- ''
print -r -- '5. Array processing with nested loops and conditional logic:'
typeset -A matrix
matrix[0,0]=1
matrix[0,1]=2
matrix[0,2]=3
matrix[1,0]=4
matrix[1,1]=5
matrix[1,2]=6
matrix[2,0]=7
matrix[2,1]=8
matrix[2,2]=9
for i in 0 1 2; do
    for j in 0 1 2; do
        value="${matrix[${$i,$j:-0}]}"
        if [ $(( value )) -gt $(( 5 )) ]; then
            print -rn -- "  [$value] "
        else
            print -rn -- "  $value "
        fi
    done
    print -r -- ''
done
print -r -- ''
print -r -- '6. Process substitution with nested commands and error handling:'
{
    print -r -- "  First word: ${test_string%% *}"
    print -r -- "  Last word: ${test_string##* }"
    print -r -- "  Middle: ${test_string#* }"
    print -r -- "  Middle: ${test_string% *}"
    print -r -- "  Uppercase: $(printf '%s' "$test_string" | tr a-z A-Z)"
    print -r -- "  Lowercase: $(printf '%s' "$test_string" | tr A-Z a-z)"
    print -r -- "  Capitalize: $(printf '%s' "$test_string" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
    print -r -- ''
    print -r -- '11. Complex arithmetic with nested expressions:'
    a=10
    b=5
    c=3
    result=$(((((a + b) * c) - ((a % b) / c))))
    print -r -- '  Expression: (a + b) * c - (a % b) / c'
    print -r -- "  Values: a=$a, b=$b, c=$c"
    print -r -- "  Result: $result"
    if [ "$(((a > b) && (b < c) || (a % 2 == 0)))" -ne 0 ]; then
        print -r -- '  Complex condition met: a > b AND (b < c OR a is even)'
    fi
    print -r -- ''
    print -r -- '12. Nested command substitution with error handling:'
    print -r -- "  Current directory: $(pwd)"
    print -r -- "  Parent directory: $(dirname "$(pwd)")"
    print -r -- "  Home directory: $(dirname "$(dirname "$(pwd)")")"
    file_info="$(stat -c '%s %y' nonexistent_file 2>/dev/null || echo 'File not found')"
    print -r -- "  File info: $file_info"
    print -r -- ''
}
print -r -- '=== Advanced Bash Idioms Examples Complete ==='
