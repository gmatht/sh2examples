#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
set -e -u
print -r -- '== More process substitution examples =='
__ps_tmp0="$(mktemp)"; print -- 'a\nc\nb' | sort >$__ps_tmp0; __ps_tmp1="$(mktemp)"; print -- 'a\nb\nd' | sort >$__ps_tmp1; diff $__ps_tmp0 $__ps_tmp1 && rm -f $__ps_tmp0 $__ps_tmp1 || echo 'Files differ'
{
    __ps_tmp2="$(mktemp)"
    printf '%s' 'name1
name2
' > $__ps_tmp2
    __ps_tmp3="$(mktemp)"
    printf '%s' 'value1
value2
' > $__ps_tmp3
    paste $__ps_tmp2 $__ps_tmp3
    rm -f $__ps_tmp2 $__ps_tmp3
}
print -r -- "status: ok"
