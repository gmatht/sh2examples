#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS

setopt shwordsplit globsubst
set -u
capture() {
    local label="$1"
    shift
    {
        local tmp_stdout
        local tmp_stderr
    }
    tmp_stdout="$(mktemp /tmp/readonly_demo_stdout_XXXXXX)"
    tmp_stderr="$(mktemp /tmp/readonly_demo_stderr_XXXXXX)"
    "$@" >"$tmp_stdout" 2>"$tmp_stderr"
    local ec=${=?}
    local so
    so="$(cat "$tmp_stdout")"
    local se
    se="$(cat "$tmp_stderr")"
    rm -f "$tmp_stdout" "$tmp_stderr"
    print -r -- "--- ["$label"] ---"
    echo "  cmd     : $*"
    print -r -- "  exitcode: "$ec""
    if [ "$so" != "" ]; then
        print -r -- "  stdout  : "$so""
    fi
    if [ "$se" != "" ]; then
        print -r -- "  stderr  : "$se""
    fi
    print -r -- ''
    return "$ec"
}
print -r -- '============================================================'
print -r -- ' SECTION 1: Basic readonly variable'
print -r -- '============================================================'
capture 01-readonly-var bash -c '
        readonly MY_VAR="hello_world"
        echo "MY_VAR=${MY_VAR}"
        # Attempt to change it (will fail, but we capture)
        MY_VAR="changed" 2>/dev/null || echo "Assignment denied: $?"
        echo "MY_VAR after attempted change=${MY_VAR}"
    '
print -r -- '============================================================'
print -r -- ' SECTION 2: readonly -p  (print readonly variables)'
print -r -- '============================================================'
capture 02-readonly-p bash -c '
        readonly FOO=alpha
        readonly BAR=beta
        readonly -p | head -5
    '
print -r -- '============================================================'
print -r -- ' SECTION 3: readonly -f  (readonly functions)'
print -r -- '============================================================'
capture 03-readonly-f bash -c '
        myfunc() { echo "Hello from myfunc"; }
        readonly -f myfunc
        myfunc
        # Attempt to unset the function (will fail)
        unset -f myfunc 2>/dev/null || echo "unset -f denied"
        # Verify function still exists
        myfunc
    '
print -r -- '============================================================'
print -r -- ' SECTION 4: readonly -a  (indexed array)'
print -r -- '============================================================'
capture 04-readonly-a bash -c '
        declare -a MY_ARR=(zero one two)
        readonly -a MY_ARR
        echo "MY_ARR[0]=${MY_ARR[0]}"
        echo "MY_ARR[1]=${MY_ARR[1]}"
        # Attempt to change an element (will fail)
        MY_ARR[0]=ZERO 2>/dev/null || echo "Array assignment denied"
        echo "MY_ARR[0] after attempt=${MY_ARR[0]}"
    '
print -r -- '============================================================'
print -r -- ' SECTION 5: readonly -A  (associative array)'
print -r -- '============================================================'
capture 05-readonly-A bash -c '
        declare -A MY_ASSOC=([key1]=val1 [key2]=val2)
        readonly -A MY_ASSOC
        echo "MY_ASSOC[key1]=${MY_ASSOC[key1]}"
        echo "MY_ASSOC[key2]=${MY_ASSOC[key2]}"
        # Attempt to change (will fail)
        MY_ASSOC[key1]=CHANGED 2>/dev/null || echo "Assoc assignment denied"
        echo "MY_ASSOC[key1] after attempt=${MY_ASSOC[key1]}"
    '
print -r -- '============================================================'
print -r -- ' SECTION 6: readonly --  (no more options)'
print -r -- '============================================================'
capture 06a-readonly-dash-ok bash -c '
        readonly -- MYVAR=hello
        echo "MYVAR=${MYVAR}"
        # Confirm it is indeed readonly
        MYVAR=world 2>/dev/null || echo "Assignment denied (expected)"
    '
capture 06b-readonly-dash-invalid bash -c '
        readonly -- -notvalid 2>&1 || true
    '
print -r -- '============================================================'
print -r -- ' SECTION 7: Invalid variable name (error case)'
print -r -- '============================================================'
capture 07-invalid-name bash -c '
        readonly 123invalid 2>&1 || true
    '
print -r -- '============================================================'
print -r -- ' SECTION 8: readonly -f -p  (list readonly functions)'
print -r -- '============================================================'
capture 08-readonly-f-p bash -c '
        f1() { :; }
        f2() { :; }
        readonly -f f1 f2
        readonly -f -p | head -5
    '
print -r -- ''
print -r -- 'All readonly demo sections completed.'
exit 0
