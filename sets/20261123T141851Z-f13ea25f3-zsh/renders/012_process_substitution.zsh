#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
set -e -u
print -r -- '== Here-string with grep -o =='
echo "$(printf '%s
' 'some pattern here' | grep -o pattern)"
print -r -- '== Process substitution with comm =='
{
    __ps_tmp0="$(mktemp)"
    printf '%s' 'a
b
' > $__ps_tmp0
    __ps_tmp1="$(mktemp)"
    printf '%s' 'b
c
' > $__ps_tmp1
    comm -12 $__ps_tmp0 $__ps_tmp1
    rm -f $__ps_tmp0 $__ps_tmp1
}
print -r -- '== readarray/mapfile =='
{
    __ps_tmp2="$(mktemp)"
    printf '%s' 'x
y
' > $__ps_tmp2
    lines=(); while IFS= read -r _map_line; do lines+=("$_map_line"); done <$__ps_tmp2
    rm -f $__ps_tmp2
}
printf '%s ' "${lines[@]}"
print -r -- ''
print -r -- '== More process substitution examples =='
__ps_tmp3="$(mktemp)"; print -- 'a\nc\nb' | sort >$__ps_tmp3; __ps_tmp4="$(mktemp)"; print -- 'a\nb\nd' | sort >$__ps_tmp4; diff $__ps_tmp3 $__ps_tmp4 && rm -f $__ps_tmp3 $__ps_tmp4 || echo 'Files differ'
{
    __ps_tmp5="$(mktemp)"
    printf '%s' 'name1
name2
' > $__ps_tmp5
    __ps_tmp6="$(mktemp)"
    printf '%s' 'value1
value2
' > $__ps_tmp6
    paste $__ps_tmp5 $__ps_tmp6
    rm -f $__ps_tmp5 $__ps_tmp6
}
