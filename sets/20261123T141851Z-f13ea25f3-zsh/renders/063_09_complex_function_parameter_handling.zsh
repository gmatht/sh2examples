#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
complex_function() {
    local args=("$@")
    local options=()
    local i=0
    while [ "$((i < ${#args[@]}))" -ne 0 ]; do
        case "${args[i]}" in
            --*)
                local key="${args[i]#--}"
                local value="${args[i+1]:-true}"
                options[$key]="$value"
                {
                    i=$((i += 2))
                }
            ;;
            -*)
                local flags="${args[i]#-}"
                local j=0
                while [ "$((j < ${#flags}))" -ne 0 ]; do
                    options[${flags:j:1}]=true
                    {
                        ((((j = j + 1) - 1)))
                    }
                done
                {
                    ((((i = i + 1) - 1)))
                }
            ;;
            *)
                break
            ;;
        esac
    done
    printf '%s\n' "Processed ${#options[@]} options"
}
echo $(complex_function --flag1 '--option1=value1' -abc)
