#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- '=== Output and Formatting Commands ==='
print -r -- "Echo result: Hello from backticks"
d="$(mktemp -d)"
cd "$d" || exit 1
print -r -- "Printf result: Number: 42, String: test"
tee_result="$(echo 'test output' | tee test_tee.txt)"
print -r -- "Tee result: $tee_result"
rm -f test_tee.txt
print -r -- '=== Output and Formatting Commands Complete ==='
cd /
rm -r -f "$d"
