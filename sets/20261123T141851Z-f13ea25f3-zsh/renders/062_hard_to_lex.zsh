#!/usr/bin/env zsh
#
# Generated by the zsh backend. Constructs used:
# - 'local': variable scoping
# - Native zsh arrays, with KSH_ARRAYS so bash's 0-based
#   subscripts carry over verbatim (zsh arrays are 1-based)
# - '(( ))' arithmetic: required for integer comparison in conditions
# - 'grep -P' helper: PCRE not in POSIX, checked at runtime
#
setopt KSH_ARRAYS
print -r -- 'Testing ambiguous operators...'
result=$((512))
print -r -- "2**3**2 = $result"
print -r -- 'Testing complex parameter expansions...'
complex_var='hello world'
print -r -- "${complex_var#*o}"
print -r -- "${complex_var##*o}"
print -r -- "${complex_var%o*}"
print -r -- "${complex_var%%o*}"
print -r -- 'Testing complex here-documents...'
print -rn -- 'This is a test line
This is not a test line
This is another test line
'
print -r -- 'Testing nested arithmetic...'
result=$((40))
print -r -- "Complex arithmetic: $result"
print -r -- 'Testing nested command substitution...'
print -r -- "Current dir: ${PWD:-$(pwd)}"
print -r -- "User: ${USER:-$(whoami)}"
print -r -- 'Testing process substitution...'
print -r -- 'Testing complex brace expansion...'
print -r -- 'a1x a1y a1z a2x a2y a2z a3x a3y a3z b1x b1y b1z b2x b2y b2z b3x b3y b3z c1x c1y c1z c2x c2y c2z c3x c3y c3z'
print -r -- 'Testing simple case patterns...'
case "$1" in
    "test")
        echo 'Matched test'
    ;;
    *)
        echo 'Default case'
    ;;
esac
complex_function() {
    local param1="$1"
    local param2="${2:-default}"
    local param3="$(printf '%s' "$3" | sed -e 's#\\"#\\\\\\"#g')"
    print -r -- "Param1: $param1"
    print -r -- "Param2: $param2"
    print -r -- "Param3: $param3"
    local result=$(print -r -- "$param1" | sed s/old/new/g)
    print -r -- "Result: $result"
}
print -r -- 'Testing simple pipeline...'
ls -l -a | grep ^d | head -5
print -r -- 'Testing mixed arithmetic...'
result=$((776))
print -r -- "Mixed base result: $result"
print -r -- 'Testing complex string interpolation...'
message="Hello, ${USER:-$(whoami)}! Your home is ${HOME:-$(echo ~)}"
print -r -- "$message"
print -r -- 'Testing simple test expressions...'
if [ -f "file.txt" ]; then
    print -r -- 'File exists'
else
    print -r -- 'File does not exist'
fi
print -r -- 'Testing complex array operations...'
array=(item1 item2 item3)
array+=(item4)
print -r -- "Array: ${array[@]}"
print -r -- "Length: ${#array[@]}"
print -r -- "First item: "${array[0]}""
test_locals() {
    local var1="$1"
    local var2="${2:-default_value}"
    local var3="$(print -r -- "$var1" | tr '[:lower:]' '[:upper:]')"
    print -r -- "Var1: $var1"
    print -r -- "Var2: $var2"
    print -r -- "Var3: $var3"
}
complex_function 'test"quote' second_param 'third"param'
test_locals hello world
