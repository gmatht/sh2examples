+    /// The same capture, with a real argv instead of `bash -c`: the words
+    /// go straight to `execvp`. `$(whoami)` reads the same bytes as bash's
+    /// `$(whoami)` — trailing newlines stripped, the child's status in
+    /// `rc` — because the pipeline engine below owns all of that; what
+    /// disappears is the shell that used to rebuild the argv from text.
+    ///
+    /// No `/* capture: bash -c */` marker: that marker names the line that
+    /// CONSUMES a site's `_cN_cmd` buffer, and this form has no buffer to
+    /// fold (`is_capture_terminator` must not match it).
+    fn emit_capture_argv(&mut self, id: usize, words: &[String]) {
+        self.need_sh = true;
+        let arr = format!("_ca{id}");
+        let expr = self.inline_pipeline_expr(
+            id,
+            &[StageRef::Exec(arr.clone())],
+            true,
+            "buf",
+            "buf_cap",
+        );
+        let init = words
+            .iter()
+            .map(|w| Self::cstr(w))
+            .collect::<Vec<_>>()
+            .join(", ");
+        self.emit(&format!(
+            "/* capture: argv */ {{ char *{arr}[] = {{{init}, 0}}; {expr}; }}"
+        ));
+    }
