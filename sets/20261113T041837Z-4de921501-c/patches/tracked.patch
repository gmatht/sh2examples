+#[cfg(test)]
+mod argv_capture_tests {
+    use super::Render;
+
+    /// `$(...)` text becomes an argv ONLY when the text really is one
+    /// simple command of literal words. Every shell feature has to be
+    /// refused, because the fallback (`bash -c`) is correct for all of
+    /// them and a wrong accept would change the program's meaning.
+    #[test]
+    fn literal_argv_accepts_only_simple_literal_commands() {
+        let w = |s: &[&str]| Some(s.iter().map(|x| x.to_string()).collect::<Vec<_>>());
+        assert_eq!(Render::literal_argv("whoami"), w(&["whoami"]));
+        assert_eq!(Render::literal_argv("  uname  -s "), w(&["uname", "-s"]));
+        // quoting is removed by the shell, so the words carry the unquoted
+        // text — exactly what `execvp` must receive
+        assert_eq!(Render::literal_argv("grep -c 'a b'"), w(&["grep", "-c", "a b"]));
+        assert_eq!(
+            Render::literal_argv("printf \"%s\" x"),
+            w(&["printf", "%s", "x"])
+        );
+        for t in [
+            "echo hi | grep h",  // pipeline
+            "a && b",            // and-list
+            "cmd; cmd2",         // sequence
+            "cmd &",             // background
+            "$(x)",              // nested substitution
+            "echo $VAR",         // expansion
+            "echo `x`",          // backtick
+            "printf '%s' *.txt", // glob
+            "cat < f",           // redirect
+            "cmd > f",           // redirect
+            "echo {a,b}",        // brace expansion
+            "echo ~",            // tilde expansion
+            "FOO=1 cmd",         // env prefix
+            "echo \"$VAR\"",     // expansion inside dquotes
+            "echo \"a\\tb\"",    // escape inside dquotes
+        ] {
+            assert_eq!(Render::literal_argv(t), None, "must refuse {t:?}");
+        }
+        assert_eq!(Render::literal_argv("echo 'x"), None, "unterminated quote");
+        assert_eq!(Render::literal_argv(""), None);
+        assert_eq!(Render::literal_argv("   "), None);
+    }
+
+    /// A builtin word must never reach `execvp`: there is no
+    /// `/usr/bin/exit`, and `/usr/bin/printf` is not bash's `printf`.
+    #[test]
+    fn builtin_words_never_exec() {
+        for w in ["exit", ":", "eval", "printf", "echo", "true", "set", "read"] {
+            assert!(Render::word_is_bash_builtin(w), "{w} is a bash builtin");
+        }
+        for w in ["whoami", "date", "uname", "stat", "grep", "sed"] {
+            assert!(
+                !Render::word_is_bash_builtin(w),
+                "{w} is an external command"
+            );
+        }
+    }
+}
