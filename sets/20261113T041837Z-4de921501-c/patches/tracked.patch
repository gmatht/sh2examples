+    /// Does bash resolve this command word to a BUILTIN? (`compgen -b`,
+    /// plus the reserved words that can stand alone as a command.) Such a
+    /// word is NEVER safe to `execvp`: bash's `exit`, `eval`, `set`,
+    /// `shift`, `umask` and friends have no binary, and `echo`/`printf`
+    /// follow bash's own argument rules rather than coreutils'.
+    fn word_is_bash_builtin(w: &str) -> bool {
+        const BUILTINS: &[&str] = &[
+            ".", ":", "[", "alias", "bg", "bind", "break", "builtin", "caller", "cd",
+            "command", "compgen", "complete", "compopt", "continue", "declare", "dirs",
+            "disown", "echo", "enable", "eval", "exec", "exit", "export", "false", "fc",
+            "fg", "getopts", "hash", "help", "history", "jobs", "kill", "let", "local",
+            "logout", "mapfile", "popd", "printf", "pushd", "pwd", "read", "readarray",
+            "readonly", "return", "set", "shift", "shopt", "source", "suspend", "test",
+            "times", "trap", "true", "type", "typeset", "ulimit", "umask", "unalias",
+            "unset", "wait", "time", "!", "}", "{",
+        ];
+        BUILTINS.contains(&w)
+    }
+
+    /// A capture's inner text as a plain argv, when it is one simple
+    /// command made only of literal words.
+    ///
+    /// REFUSE > GUESS: any unquoted shell metacharacter (`$` backtick `|`
+    /// `&` `;` `<` `>` `(` `)` `{` `}` `[` `]` `*` `?` `~` `#` `!` `\`
+    /// `=`), a double-quoted `$`/backtick/`\`, and an unterminated quote
+    /// all return None so the caller keeps the shell site. What survives
+    /// needs no shell at all: bash builds exactly this argv and `execvp`s
+    /// it, so a forked exec of the same words is the faithful lowering.
+    fn literal_argv(text: &str) -> Option<Vec<String>> {
+        let mut words: Vec<String> = Vec::new();
+        let mut cur = String::new();
+        let mut have = false;
+        let mut chars = text.chars();
+        while let Some(c) = chars.next() {
+            match c {
+                ' ' | '\t' | '\n' => {
+                    if have {
+                        words.push(std::mem::take(&mut cur));
+                        have = false;
+                    }
+                }
+                '\'' => {
+                    have = true;
+                    loop {
+                        match chars.next()? {
+                            '\'' => break,
+                            ch => cur.push(ch),
+                        }
+                    }
+                }
+                '"' => {
+                    have = true;
+                    loop {
+                        match chars.next()? {
+                            '"' => break,
+                            '$' | '`' | '\\' => return None,
+                            ch => cur.push(ch),
+                        }
+                    }
+                }
+                '$' | '`' | '|' | '&' | ';' | '<' | '>' | '(' | ')' | '{' | '}' | '['
+                | ']' | '*' | '?' | '~' | '#' | '!' | '\\' | '=' => return None,
+                ch => {
+                    have = true;
+                    cur.push(ch);
+                }
+            }
+        }
+        if have {
+            words.push(cur);
+        }
+        if words.first().is_none_or(|w| w.is_empty()) {
+            None
+        } else {
+            Some(words)
+        }
+    }
