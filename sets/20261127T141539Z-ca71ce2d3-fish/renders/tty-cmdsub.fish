#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function __sh2_setrc
    # re-raise a command's exact exit code as $status
    return $argv[1]
end

set u
function capture
    set -l label "$argv[1]"
    set -e argv[1]
    begin
        set -l tmp_stdout
        set -l tmp_stderr
    end
    set tmp_stdout (begin
mktemp /tmp/tty_demo_stdout_XXXXXX
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
    set tmp_stderr (begin
mktemp /tmp/tty_demo_stderr_XXXXXX
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
    $argv >"$tmp_stdout" 2>"$tmp_stderr"
    set -l ec (string match -ar '[^ \t\n]+' -- $status)
    set -l so
    set so (begin
cat "$tmp_stdout"
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
    set -l se
    set se (begin
cat "$tmp_stderr"
end | string collect); set -l __sh2_rc $pipestatus[1]; test $__sh2_rc -eq 0; or __sh2_setrc $__sh2_rc
    rm -f "$tmp_stdout" "$tmp_stderr"
    printf '%s\n' "--- [$label] ---"
    printf '%s\n' "  cmd     : $argv"
    printf '%s\n' "  exitcode: $ec"
    if [ "$so" != "" ]
        printf '%s\n' "  stdout  : $so"
    else
        printf '%s\n' '  stdout  : (empty)'
    end
    if [ "$se" != "" ]
        printf '%s\n' "  stderr  : $se"
    end
    printf '%s\n' ''
    return "$ec"
end
set TTY_DEV ''
for dev in /dev/pts/2 /dev/pts/3 /dev/pts/4
    if [ -r "$dev" ]
        set TTY_DEV "$dev"
        break
    end
end
if ! [ "$TTY_DEV" != "" ]
    for dev in /dev/pts/*
        if [ -r "$dev" ]
            set TTY_DEV "$dev"
            break
        end
    end
end
printf '%s\n' (string join '' -- "Using terminal device: " (test -n "$TTY_DEV"; and printf '%s' "$TTY_DEV"; or printf '%s' "NONE"))
printf '%s\n' ''
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 1: tty (default) — with a real terminal'
printf '%s\n' '============================================================'
if [ "$TTY_DEV" != "" ]
    capture 01-default-terminal tty <"$TTY_DEV"
else
    printf '%s\n' '  (skipped — no terminal device available)'
    printf '%s\n' ''
end
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 2: tty (default) — stdin from /dev/null'
printf '%s\n' '============================================================'
capture 02-not-a-tty tty </dev/null
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 3: tty (default) — piped input'
printf '%s\n' '============================================================'
capture 03-pipe-notty bash -c 'echo "dummy" | tty'
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 4: tty -s — with a real terminal (silent)'
printf '%s\n' '============================================================'
if [ "$TTY_DEV" != "" ]
    capture 04-silent-terminal tty -s <"$TTY_DEV"
else
    printf '%s\n' '  (skipped — no terminal device available)'
    printf '%s\n' ''
end
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 5: tty -s — stdin from /dev/null (silent, not a tty)'
printf '%s\n' '============================================================'
capture 05-silent-notty tty -s </dev/null
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 6: tty -s — piped input (silent, not a tty)'
printf '%s\n' '============================================================'
capture 06-silent-pipe bash -c 'echo "dummy" | tty -s'
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 7: tty --silent — long form, with a real terminal'
printf '%s\n' '============================================================'
if [ "$TTY_DEV" != "" ]
    capture 07-long-silent tty --silent <"$TTY_DEV"
else
    printf '%s\n' '  (skipped — no terminal device available)'
    printf '%s\n' ''
end
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 8: tty --quiet — long form, with a real terminal'
printf '%s\n' '============================================================'
if [ "$TTY_DEV" != "" ]
    capture 08-long-quiet tty --quiet <"$TTY_DEV"
else
    printf '%s\n' '  (skipped — no terminal device available)'
    printf '%s\n' ''
end
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 9: tty --silent — stdin from /dev/null (not a tty)'
printf '%s\n' '============================================================'
capture 09-long-silent-notty tty --silent </dev/null
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 10: tty --quiet — stdin from /dev/null (not a tty)'
printf '%s\n' '============================================================'
capture 10-long-quiet-notty tty --quiet </dev/null
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 11: tty (default) — inheriting stdin from the script'
printf '%s\n' '============================================================'
capture 11-inherited tty
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 12: tty -s — inheriting stdin from the script'
printf '%s\n' '============================================================'
capture 12-inherited-silent tty -s
printf '%s\n' '============================================================'
printf '%s\n' ' SECTION 13: tty -s -s — repeated silent flag'
printf '%s\n' '============================================================'
if [ "$TTY_DEV" != "" ]
    capture 13-double-silent tty -s -s <"$TTY_DEV"
else
    printf '%s\n' '  (skipped — no terminal device available)'
    printf '%s\n' ''
end
printf '%s\n' ''
printf '%s\n' 'All tty demo sections completed.'
