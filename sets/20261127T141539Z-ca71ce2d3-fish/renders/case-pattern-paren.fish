#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
set arch x86_64
switch "$arch"
    case 'i*86' 'x86_64'
        set cpu pc
    case '*'
        set cpu unknown
end
printf '%s' "cpu=[$cpu]
"
set arch arm64
switch "$arch"
    case 'i*86' 'x86_64'
        set cpu pc
    case '*'
        set cpu unknown
end
printf '%s' "unknown: cpu=[$cpu]
"
