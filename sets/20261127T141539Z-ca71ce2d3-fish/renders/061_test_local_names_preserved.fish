#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
function _num --argument val
    # bash coerces non-numeric arith values to 0; fish math errors
    if string match -qr -- '^-?[0-9]+$' $val
        echo $val
    else
        echo 0
    end
end

function test_math
    set -l first_number "$argv[1]"
    set -l second_number "$argv[2]"
    set -l operation "$argv[3]"
    switch "$operation"
        case 'add'
            echo (math --scale 0 "($(_num $first_number) + $(_num $second_number))")
        case 'subtract'
            echo (math --scale 0 "($(_num $first_number) - $(_num $second_number))")
        case 'multiply'
            echo (math --scale 0 "($(_num $first_number) * $(_num $second_number))")
        case '*'
            echo "Unknown operation: $operation"
    end
end
function test_strings
    set -l input_string "$argv[1]"
    set -l search_pattern "$argv[2]"
    set -l replacement "$argv[3]"
    switch "$search_pattern"
        case 'start'
            echo "Replacing start of: $input_string with: $replacement"
        case 'end'
            echo "Replacing end of: $input_string with: $replacement"
        case 'middle'
            echo "Replacing middle of: $input_string with: $replacement"
        case '*'
            echo "Unknown pattern: $search_pattern for string: $input_string"
    end
end
function test_arrays
    set -l array_name "$argv[1]"
    set -l index "$argv[2]"
    set -l new_value "$argv[3]"
    switch "$index"
        case 'first'
            echo "Setting first element of $array_name to $new_value"
        case 'last'
            echo "Setting last element of $array_name to $new_value"
        case '*'
            echo "Setting element $index of $array_name to $new_value"
    end
end
echo (test_math 10 5 add)
echo (test_math 10 5 multiply)
echo (test_strings 'hello world' start hi)
echo (test_strings 'hello world' end bye)
echo (test_arrays my_array first new_value)
echo (test_arrays my_array last final_value)
