#!/usr/bin/env fish
#
# Generated by the fish backend. Fish-specific constructs:
# - 'set' for assignment (no var=value)
# - 'end' for all block closers (no fi/done/esac)
# - 'math' for arithmetic (no $(( )))
# - command substitution uses (cmd) not $(cmd)
#
if printf '%s\n' "$var" | grep -Eq '^[0-9]+$' && [ (math --scale 0 "$var") -gt (math --scale 0 "0") ] && [ -f "$file" ]
    if printf '%s\n' "$array" | grep -Eq '"value"' || [ (math --scale 0 "$(count $array)") -gt (math --scale 0 "5") ]
        if [ "$(echo "$var" | grep -q "pattern")" ]
            printf '%s\n' 'Deeply nested condition met'
        end
    end
end
